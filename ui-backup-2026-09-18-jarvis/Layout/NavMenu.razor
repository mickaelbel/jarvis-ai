@using JarvisAI.Web.Services
@using Microsoft.JSInterop
@inject OllamaModelService OllamaService
@inject NavigationManager Navigation
@inject DebugModeStore DebugMode
@implements IDisposable

<nav class="nav-sidebar @(_expanded ? "expanded" : "")" @onmouseenter="Expand" @onmouseleave="Collapse">
    @* ── Logo / brand ── *@
    <div class="nav-section">
        <button type="button" @onclick="NewChat" class="nav-btn-new" title="Nouvelle conversation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span class="nav-label">Nouveau chat</span>
        </button>
    </div>

    @* ── Navigation links ── *@
    <div class="nav-section nav-links">
        <NavLink href="/chat" class="nav-link" Match="NavLinkMatch.Prefix">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span class="nav-label">Chat</span>
        </NavLink>
        <NavLink href="/history" class="nav-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <span class="nav-label">Historique</span>
        </NavLink>
        <NavLink href="/agent" class="nav-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/>
            </svg>
            <span class="nav-label">Agent</span>
        </NavLink>
        <NavLink href="/memory" class="nav-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            <span class="nav-label">Memoire</span>
        </NavLink>
        <NavLink href="/reminders" class="nav-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            <span class="nav-label">Rappels</span>
        </NavLink>
    </div>

    @* ── Bottom section ── *@
    <div class="nav-section nav-bottom">
        <NavLink href="/settings" class="nav-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
            <span class="nav-label">Parametres</span>
        </NavLink>

        @* ── Status indicators ── *@
        <div class="nav-status">
            <div class="nav-status-row" title="@(_ollamaOnline ? "Ollama pret" : "Ollama hors ligne")">
                <span class="nav-dot @(_ollamaOnline ? "bg-accent" : "bg-red-500")"></span>
                <span class="nav-label text-[11px]">Ollama</span>
                @if (!_ollamaOnline)
                {
                    <button class="nav-status-btn" @onclick="RetryOllama">Start</button>
                }
            </div>
            <div class="nav-status-row" title="Mode vocal">
                <span class="nav-dot @(VoiceUi.Enabled ? "bg-accent" : "bg-muted")"></span>
                <span class="nav-label text-[11px]">Vocal</span>
                <label class="nav-toggle ml-auto">
                    <input type="checkbox" class="sr-only peer" @bind="_voiceModeOn" @bind:after="ToggleVoiceMode" />
                    <div class="nav-toggle-track"></div>
                </label>
            </div>
        </div>
    </div>
</nav>

@code {
    [Inject] IJSRuntime JS { get; set; } = default!;
    [Inject] VoiceUiState VoiceUi { get; set; } = default!;

    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(10) };

    private bool _ollamaOnline;
    private DotNetObjectReference<NavMenu>? _dotNetRef;
    private string _voiceStatus = "";
    private string _voiceRaw = "";
    private bool _voiceModeOn = true;
    private bool _wakeWordOn = true;
    private bool _lastKnownVoiceEnabled = true;
    private bool _lastKnownWakeWordEnabled = true;
    private bool _engineActive;
    private string _micro = "inconnu";
    private string _wakeWord = "inconnu";
    private string _stt = "inconnu";
    private string _tts = "inconnu";
    private string _listening = "inconnu";
    private string _captureMode = "inconnu";
    private string _ambient = "";
    private DateTime? _startedAt;
    private System.Threading.Timer? _statusTimer;
    private bool _expanded;

    private void Expand() { _expanded = true; }
    private void Collapse() { _expanded = false; }

    protected override async Task OnInitializedAsync()
    {
        VoiceUi.Changed += OnVoiceUiChanged;
        DebugMode.Changed += OnDebugModeChanged;
        _ollamaOnline = await OllamaService.IsAvailableAsync();
        await InitVoiceAsync();
    }

    private void OnDebugModeChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private async Task InitVoiceAsync()
    {
        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var engineActive = false;
            try
            {
                var statusRes = await Http.GetAsync(Navigation.BaseUri + "api/app-voice/status");
                if (statusRes.IsSuccessStatusCode)
                {
                    using var statusDoc = System.Text.Json.JsonDocument.Parse(await statusRes.Content.ReadAsStringAsync());
                    engineActive = statusDoc.RootElement.TryGetProperty("engineActive", out var ea) && ea.GetBoolean();
                }
            }
            catch { }

            try
            {
                var settingsRes = await Http.GetAsync(Navigation.BaseUri + "api/voice/settings");
                if (settingsRes.IsSuccessStatusCode)
                {
                    using var settingsDoc = System.Text.Json.JsonDocument.Parse(await settingsRes.Content.ReadAsStringAsync());
                    if (settingsDoc.RootElement.TryGetProperty("voiceEnabled", out var ve))
                        _voiceModeOn = ve.GetBoolean();
                    if (settingsDoc.RootElement.TryGetProperty("wakeWordEnabled", out var ww))
                        _wakeWordOn = ww.GetBoolean();
                }
                _lastKnownVoiceEnabled = _voiceModeOn;
                _lastKnownWakeWordEnabled = _wakeWordOn;
            }
            catch { }

            await JS.InvokeVoidAsync("jarvisVoice.setEngineActive", engineActive);
            _voiceStatus = engineActive
                ? "Actif (application de bureau)"
                : (_voiceModeOn ? "Lancez l'application de bureau" : "Desactive");
            VoiceUi.SetEnabled(false);
            await InvokeAsync(StateHasChanged);

            _statusTimer ??= new System.Threading.Timer(_ => PollStatus(), null, 2000, 2000);
        }
        catch { }
    }

    private void PollStatus()
    {
        try
        {
            var statusRes = Http.GetAsync(Navigation.BaseUri + "api/app-voice/status").Result;
            if (!statusRes.IsSuccessStatusCode) return;
            using var doc = System.Text.Json.JsonDocument.Parse(statusRes.Content.ReadAsStringAsync().Result);
            var root = doc.RootElement;
            _engineActive = root.TryGetProperty("engineActive", out var ea) && ea.GetBoolean();
            _micro = ReadString(root, "microState");
            _wakeWord = ReadString(root, "wakeWordState");
            _stt = ReadString(root, "sttState");
            _tts = ReadString(root, "ttsState");
            _listening = ReadString(root, "listeningState");
            _captureMode = ReadString(root, "captureMode");
            _ambient = ReadString(root, "ambient");
            if (root.TryGetProperty("startedAt", out var st) && st.ValueKind == System.Text.Json.JsonValueKind.String)
                _startedAt = st.GetDateTime();
            _voiceStatus = _engineActive
                ? "Actif (application de bureau)"
                : (_voiceModeOn ? "Lancez l'application de bureau" : "Desactive");
        }
        catch { }
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleVoiceMode()
    {
        var enabled = _voiceModeOn;
        if (enabled == _lastKnownVoiceEnabled) { StateHasChanged(); return; }
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new { voiceEnabled = enabled });
            var res = await Http.PostAsync(Navigation.BaseUri + "api/voice/settings",
                new StringContent(json, System.Text.Encoding.UTF8, "application/json"));
            if (!res.IsSuccessStatusCode) _voiceModeOn = !enabled;
            else { _lastKnownVoiceEnabled = enabled; _voiceStatus = enabled ? "Actif" : "Desactive"; }
        }
        catch { _voiceModeOn = !enabled; }
        StateHasChanged();
    }

    private async Task ToggleWakeWord()
    {
        var enabled = _wakeWordOn;
        if (enabled == _lastKnownWakeWordEnabled) { StateHasChanged(); return; }
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new { wakeWordEnabled = enabled });
            var res = await Http.PostAsync(Navigation.BaseUri + "api/voice/settings",
                new StringContent(json, System.Text.Encoding.UTF8, "application/json"));
            if (!res.IsSuccessStatusCode) _wakeWordOn = !enabled;
            else { _lastKnownWakeWordEnabled = enabled; _wakeWord = enabled ? "continu (avec mot-cle)" : "continu (sans mot-cle)"; }
        }
        catch { _wakeWordOn = !enabled; }
        StateHasChanged();
    }

    private static string ReadString(System.Text.Json.JsonElement root, string name)
        => root.TryGetProperty(name, out var v) ? v.GetString() ?? "inconnu" : "inconnu";

    [JSInvokable]
    public void OnListening(bool listening) => InvokeAsync(() => VoiceUi.SetEnabled(listening));

    [JSInvokable]
    public void OnStatus(string message) { _voiceStatus = message; InvokeAsync(StateHasChanged); }

    [JSInvokable]
    public void OnStatusPanel(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            _engineActive = root.TryGetProperty("engineActive", out var ea) && ea.GetBoolean();
            _micro = ReadString(root, "microState");
            _wakeWord = ReadString(root, "wakeWordState");
            _stt = ReadString(root, "sttState");
            _tts = ReadString(root, "ttsState");
            _listening = ReadString(root, "listeningState");
            _captureMode = ReadString(root, "captureMode");
            _ambient = ReadString(root, "ambient");
            if (root.TryGetProperty("startedAt", out var st) && st.ValueKind == System.Text.Json.JsonValueKind.String)
                _startedAt = st.GetDateTime();
        }
        catch { }
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnLevel(System.Text.Json.JsonElement e) { _voiceRaw = e.GetRawText(); InvokeAsync(StateHasChanged); }

    private void OnVoiceUiChanged() => InvokeAsync(StateHasChanged);

    private void NewChat()
    {
        Pages.Chat.RequestNewChat();
        Navigation.NavigateTo("/chat?new=1");
    }

    public void Dispose()
    {
        VoiceUi.Changed -= OnVoiceUiChanged;
        DebugMode.Changed -= OnDebugModeChanged;
        _statusTimer?.Dispose();
        _statusTimer = null;
        _dotNetRef?.Dispose();
    }

    private async Task RetryOllama()
    {
        if (_ollamaOnline) return;
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = "ollama", Arguments = "serve",
                UseShellExecute = true, CreateNoWindow = true,
                WindowStyle = System.Diagnostics.ProcessWindowStyle.Hidden
            });
            await Task.Delay(3000);
            for (int i = 0; i < 5; i++)
            {
                if (await OllamaService.IsAvailableAsync()) { _ollamaOnline = true; StateHasChanged(); return; }
                await Task.Delay(2000);
            }
        }
        catch { }
        _ollamaOnline = await OllamaService.IsAvailableAsync();
        StateHasChanged();
    }
}
