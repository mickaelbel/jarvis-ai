@inherits LayoutComponentBase
@using System.Text.Json
@inject NavigationManager Navigation

<div class="app-shell">
    <NavMenu />
    <div class="app-main">
        <header class="app-topbar">
            <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-primary tracking-tight">Jarvis</span>
                <span class="text-[10px] text-muted bg-surface px-1.5 py-0.5 rounded-full">AI</span>
            </div>
        </header>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<ConfirmDialog />
<ToastNotification />

@code {
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(5) };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var res = await Http.GetAsync(Navigation.BaseUri + "api/setup/status");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("firstRun", out var fr) && fr.GetBoolean())
                Navigation.NavigateTo("/setup", replace: true);
        }
        catch { }
    }
}
