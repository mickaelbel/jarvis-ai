<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JarvisAI.LiveValidation</AssemblyName>
    <RootNamespace>JarvisAI.LiveValidation</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\JarvisAI.Infrastructure.csproj" />
    <ProjectReference Include="..\Application\JarvisAI.Application.csproj" />
    <ProjectReference Include="..\Domain\JarvisAI.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Infrastructure\tessdata\**\*">
      <Link>tessdata\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
