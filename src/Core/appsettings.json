{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "JarvisAI": "Debug"
    }
  },
  "Jarvis": {
    "Name": "Jarvis AI",
    "Version": "1.0.0",
    "AutoStartPlugins": true
  },
  "AI": {
    "DefaultProvider": "Ollama",
    "DefaultModel": "llama3.1",
    "SystemPrompt": "You are Jarvis, a helpful AI assistant. You can use tools to answer questions. Be concise and accurate.",
    "Temperature": 0.7,
    "MaxTokens": 2048,
    "MaxToolRounds": 5,
    "OllamaBaseUrl": "http://localhost:11434",
    "OpenAIBaseUrl": "https://api.openai.com",
    "OpenAIApiKey": ""
  },
  "YouTube": {
    "ApiKey": "REDACTED"
  }
}
