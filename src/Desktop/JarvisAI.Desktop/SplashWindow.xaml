<Window x:Class="JarvisAI.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis AI" Height="340" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="#171717" CornerRadius="16" BorderBrush="#2a2a2a" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
            <TextBlock Text="JARVIS" FontSize="38" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"
                       FontFamily="Segoe UI, Arial" />
            <Grid Margin="0,14,0,0" Height="20">
                <TextBlock x:Name="StatusText" Text="Démarrage..."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="13" Foreground="#8b8b8b"
                           FontFamily="Segoe UI, Arial">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StatusTranslate" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <Border Width="220" Height="4" Background="#2a2a2a" CornerRadius="2"
                    HorizontalAlignment="Center" Margin="0,18,0,0" VerticalAlignment="Center">
                <Grid>
                    <Border x:Name="ProgressBar" Width="0" Height="4" Background="#6366f1"
                            CornerRadius="2" HorizontalAlignment="Left" />
                    <Border x:Name="Shimmer" Width="40" Height="4" Background="#c7c9ff"
                            CornerRadius="2" HorizontalAlignment="Left" Opacity="0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ShimmerTranslate" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="PercentBadge" Background="#252525" CornerRadius="999" Padding="8,3"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock x:Name="PercentText" Text="0%" FontSize="11" Foreground="#c7c9ff"
                           FontFamily="Segoe UI" FontWeight="SemiBold" />
            </Border>
        </StackPanel>
    </Border>
</Window>
