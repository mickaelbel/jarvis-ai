@page "/plugins"
@using JarvisAI.Application.Plugins
@using JarvisAI.Web.Services
@inject IPluginManager PluginManager
@inject IExternalPluginManager ExternalPluginManager
@inject ToastService Toasts
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold text-primary">Plugins</h1>
    </div>

    @* ═══════════════ EXTERNAL PLUGINS ═══════════════ *@
    <div class="mb-8">
        <div class="flex items-center gap-2 mb-4">
            <h2 class="text-sm font-semibold text-secondary">Plugins Externes</h2>
            <span class="text-[10px] px-2 py-0.5 rounded bg-accent/10 text-accent">@_externalPlugins.Count</span>
        </div>

        @if (_externalPlugins.Count == 0)
        {
            <div class="text-center py-8 text-muted text-sm">Aucun plugin externe disponible</div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-3">
                @foreach (var plugin in _externalPlugins)
                {
                    <div class="bg-surface border border-border rounded-xl p-4 jarvis-card">
                        <div class="flex items-start gap-3">
                            <span class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center text-sm font-bold flex-shrink-0">
                                @plugin.Name[..Math.Min(2, plugin.Name.Length)].ToUpperInvariant()
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-sm font-semibold text-primary">@plugin.Name</span>
                                    <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded @GetExternalStatusClass(plugin.Status)">
                                        @GetExternalStatusText(plugin.Status)
                                    </span>
                                </div>
                                <div class="text-xs text-muted mt-0.5">@plugin.Description</div>
                                <div class="text-[10px] text-muted/50 mt-0.5">v@(plugin.Version) · @plugin.Author · @plugin.TargetApplication</div>
                            </div>
                        </div>

                        @* Version selector + Install button *@
                        <div class="mt-3 flex items-center gap-2 flex-wrap">
                            @if (plugin.Status == ExternalPluginStatus.NotInstalled)
                            {
                                <select @bind="_selectedVersions[plugin.Id]" class="text-xs px-2 py-1 rounded bg-mainbg border border-border text-primary">
                                    @foreach (var ver in plugin.SupportedVersions)
                                    {
                                        <option value="@ver">Blender @ver</option>
                                    }
                                </select>
                                <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors border-0 cursor-pointer"
                                        @onclick="() => InstallPlugin(plugin.Id)" disabled="@_installing.Contains(plugin.Id)">
                                    @if (_installing.Contains(plugin.Id))
                                    {
                                        <span>Installation...</span>
                                    }
                                    else
                                    {
                                        <span>Installer</span>
                                    }
                                </button>
                            }
                            else if (plugin.Status == ExternalPluginStatus.Installed)
                            {
                                <span class="text-[10px] px-2 py-0.5 rounded bg-green-500/10 text-green-400">
                                    Installé dans @plugin.InstalledVersion
                                </span>
                                <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors border-0 cursor-pointer"
                                        @onclick="() => UninstallPlugin(plugin.Id)">
                                    Désinstaller
                                </button>
                                <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-surface text-secondary hover:text-primary transition-colors border border-border cursor-pointer"
                                        @onclick="() => UpdatePlugin(plugin.Id)">
                                    Mettre à jour
                                </button>
                            }
                            else if (plugin.Status == ExternalPluginStatus.Error)
                            {
                                <span class="text-[10px] px-2 py-0.5 rounded bg-red-500/10 text-red-400">Erreur</span>
                                <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors border-0 cursor-pointer"
                                        @onclick="() => InstallPlugin(plugin.Id)">
                                    Réessayer
                                </button>
                            }
                            else if (plugin.Status == ExternalPluginStatus.Downloading)
                            {
                                <span class="text-[10px] px-2 py-0.5 rounded bg-accent/10 text-accent animate-pulse">Téléchargement...</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ═══════════════ INTERNAL PLUGINS ═══════════════ *@
    <div>
        <div class="flex items-center gap-2 mb-4">
            <h2 class="text-sm font-semibold text-secondary">Plugins Internes</h2>
            <span class="text-[10px] px-2 py-0.5 rounded bg-surface text-muted">@_plugins.Count</span>
            @if (_plugins.Count > 0)
            {
                <button class="ml-auto px-3 py-1.5 text-xs rounded-lg bg-surface border border-border text-secondary hover:text-primary transition-colors border-0 cursor-pointer" @onclick="ReloadAll" title="Reload all">Reload all</button>
            }
        </div>

        @if (_plugins.Count == 0)
        {
            <div class="text-center py-8 text-muted text-sm">Aucun plugin interne</div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                @foreach (var plugin in _plugins)
                {
                    var tools = PluginManager.GetPluginTools(plugin.Id);
                    <div class="bg-surface border border-border rounded-xl p-4 jarvis-card">
                        <div class="flex items-start gap-3">
                            <span class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center text-sm font-bold flex-shrink-0">@plugin.Name[..Math.Min(1, plugin.Name.Length)].ToUpperInvariant()</span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-sm font-semibold text-primary">@plugin.Name</span>
                                    <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded @GetStateClass(plugin.State)">@plugin.State</span>
                                </div>
                                <div class="text-xs text-muted mt-0.5 line-clamp-2">@plugin.Description</div>
                                <div class="text-[10px] text-muted/50 mt-0.5">v@(plugin.Version) · @plugin.Author · @plugin.Id</div>
                            </div>
                        </div>

                        <div class="mt-3 space-y-2">
                            <div>
                                <div class="text-[10px] text-muted mb-1">Tools (@tools.Count)</div>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var tool in tools.Take(6))
                                    {
                                        <span class="text-[10px] px-2 py-0.5 rounded bg-accent/10 text-accent font-mono">@tool</span>
                                    }
                                    @if (tools.Count > 6)
                                    {
                                        <span class="text-[10px] px-2 py-0.5 rounded bg-accent/10 text-accent">+@(tools.Count - 6)</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 mt-4">
                            @if (plugin.State == PluginState.Running)
                            {
                                <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors border-0 cursor-pointer" @onclick="() => StopPlugin(plugin.Id)">Stop</button>
                            }
                            else
                            {
                                <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors border-0 cursor-pointer" @onclick="() => StartPlugin(plugin.Id)">Start</button>
                            }
                            <button class="px-3 py-1.5 text-xs font-medium rounded-lg bg-surface text-secondary hover:text-primary transition-colors border border-border cursor-pointer" @onclick="() => ReloadPlugin(plugin.Id)">Reload</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<PluginMetadata> _plugins = new();
    private List<ExternalPlugin> _externalPlugins = new();
    private Dictionary<string, string> _selectedVersions = new();
    private HashSet<string> _installing = new();

    protected override async Task OnInitializedAsync()
    {
        try { await PluginManager.DiscoverAsync(""); } catch { }
        _plugins = PluginManager.GetAllMetadata().ToList();

        _externalPlugins = (await ExternalPluginManager.GetPluginsAsync()).ToList();

        // Init selected versions
        foreach (var plugin in _externalPlugins)
        {
            if (plugin.SupportedVersions.Count > 0)
                _selectedVersions[plugin.Id] = plugin.SupportedVersions.First();
        }
    }

    private async Task InstallPlugin(string pluginId)
    {
        _installing.Add(pluginId);
        StateHasChanged();

        try
        {
            var version = _selectedVersions.GetValueOrDefault(pluginId, "5.1");
            var success = await ExternalPluginManager.InstallAsync(pluginId, version);

            _externalPlugins = (await ExternalPluginManager.GetPluginsAsync()).ToList();

            if (success)
                Toasts.ShowSuccess("Plugin", $"Installé dans Blender {version} !");
            else
                Toasts.ShowError("Plugin", "Installation échouée");
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Plugin", ex.Message);
        }
        finally
        {
            _installing.Remove(pluginId);
            StateHasChanged();
        }
    }

    private async Task UninstallPlugin(string pluginId)
    {
        try
        {
            await ExternalPluginManager.UninstallAsync(pluginId);
            _externalPlugins = (await ExternalPluginManager.GetPluginsAsync()).ToList();
            Toasts.ShowInfo("Plugin", "Désinstallé.");
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Plugin", ex.Message);
        }
    }

    private async Task UpdatePlugin(string pluginId)
    {
        try
        {
            await ExternalPluginManager.UpdateAsync(pluginId);
            _externalPlugins = (await ExternalPluginManager.GetPluginsAsync()).ToList();
            Toasts.ShowSuccess("Plugin", "Mis à jour !");
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Plugin", ex.Message);
        }
    }

    // ── Internal plugins ──

    private async Task StartPlugin(string id)
    {
        try
        {
            await PluginManager.StartAsync(id);
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowSuccess("Plugin", $"« {id} » démarré.");
        }
        catch (Exception ex)
        {
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowError("Plugin", ex.Message);
        }
    }

    private async Task StopPlugin(string id)
    {
        try
        {
            await PluginManager.StopAsync(id);
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowInfo("Plugin", $"« {id} » arrêté.");
        }
        catch (Exception ex)
        {
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowError("Plugin", ex.Message);
        }
    }

    private async Task ReloadPlugin(string id)
    {
        try
        {
            await PluginManager.StopAsync(id);
            await PluginManager.UnloadAsync(id);
            await PluginManager.LoadAsync(id);
            await PluginManager.StartAsync(id);
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowSuccess("Plugin", $"« {id} » rechargé.");
        }
        catch (Exception ex)
        {
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowError("Plugin", ex.Message);
        }
    }

    private async Task ReloadAll()
    {
        try
        {
            await PluginManager.StopAllAsync();
            foreach (var plugin in _plugins.ToList())
            {
                await PluginManager.UnloadAsync(plugin.Id);
                await PluginManager.LoadAsync(plugin.Id);
            }
            await PluginManager.StartAllAsync();
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowSuccess("Plugins", "Tous rechargés.");
        }
        catch (Exception ex)
        {
            _plugins = PluginManager.GetAllMetadata().ToList();
            Toasts.ShowError("Plugins", ex.Message);
        }
    }

    private static string GetStateClass(PluginState state) => state switch
    {
        PluginState.Running => "text-accent bg-accent/10",
        PluginState.Error => "text-red-400 bg-red-500/10",
        _ => "text-muted bg-surface"
    };

    private static string GetExternalStatusClass(ExternalPluginStatus status) => status switch
    {
        ExternalPluginStatus.Installed => "text-green-400 bg-green-500/10",
        ExternalPluginStatus.Downloading => "text-accent bg-accent/10",
        ExternalPluginStatus.Installing => "text-accent bg-accent/10",
        ExternalPluginStatus.Error => "text-red-400 bg-red-500/10",
        _ => "text-muted bg-surface"
    };

    private static string GetExternalStatusText(ExternalPluginStatus status) => status switch
    {
        ExternalPluginStatus.Installed => "Installé",
        ExternalPluginStatus.NotInstalled => "Non installé",
        ExternalPluginStatus.Downloading => "Téléchargement...",
        ExternalPluginStatus.Installing => "Installation...",
        ExternalPluginStatus.UpdateAvailable => "Mise à jour dispo",
        ExternalPluginStatus.Error => "Erreur",
        _ => "Inconnu"
    };
}
