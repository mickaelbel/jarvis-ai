    private Task OnToolStartedAsync(AgentToolStartedEvent evt, CancellationToken ct)
    {
        if (_disposed || _activeEpoch != _chatEpoch) return Task.CompletedTask;
        _toolActivities.Add(new ToolActivity { ToolName = evt.ToolName, Args = evt.Arguments });
        _toolCallCount++;
        _streamState = StreamState.ToolExecution;
        return SafeInvoke(StateHasChanged);
    }

    private Task OnToolExecutedAsync(AgentToolExecutedEvent evt, CancellationToken ct)
    {
        if (_disposed || _activeEpoch != _chatEpoch) return Task.CompletedTask;
        var activity = _toolActivities.LastOrDefault(a => a.ToolName == evt.ToolName && a.Status == "running");
        if (activity is null) return Task.CompletedTask;
        activity.Status = evt.Success ? "done" : "error";
        activity.DurationMs = evt.Duration.TotalMilliseconds;
        activity.Result = evt.Result;
        activity.Error = evt.ErrorMessage;
        return SafeInvoke(StateHasChanged);
    }

    private Task OnImageGeneratedAsync(ImageGeneratedEvent evt, CancellationToken ct)
    {
        if (_disposed || _activeEpoch != _chatEpoch) return Task.CompletedTask;
        _pendingGenImages.Add(new GeneratedImageUi(evt.Prompt, evt.DataUrl, evt.FilePath));
        return SafeInvoke(StateHasChanged);
    }

    private void DrainPendingImages(ChatMessage msg)
    {
        if (_pendingGenImages.Count == 0) return;
        (msg.GeneratedImages ??= new List<GeneratedImageUi>()).AddRange(_pendingGenImages);
        _pendingGenImages.Clear();
    }

    private Task OnPlanCreatedAsync(PlanCreatedEvent evt, CancellationToken ct)
    {
        if (_disposed || _activeEpoch != _chatEpoch) return Task.CompletedTask;
        if (!_livePlans.ContainsKey(evt.PlanId))
            _livePlans[evt.PlanId] = new List<PlanStepUi>();
        AttachPlanToLastMessage(evt.PlanId);
        return SafeInvoke(StateHasChanged);
    }

    private Task OnPlanStepAsync(IEvent evt, CancellationToken ct)
    {
        if (_disposed || _activeEpoch != _chatEpoch) return Task.CompletedTask;
        switch (evt)
        {
            case PlanStepStartedEvent s:
                var started = EnsurePlanStep(s.PlanId, s.StepIndex, s.Action, s.ToolName);
                started.Status = "running";
                break;
            case PlanStepCompletedEvent c:
                var done = EnsurePlanStep(c.PlanId, c.StepIndex, c.Action, null);
                done.Status = c.Success ? "done" : "error";
                done.DurationMs = c.Duration.TotalMilliseconds;
                break;
        }
        AttachPlanToLastMessage(GetPlanIdFromEvent(evt));
        return SafeInvoke(StateHasChanged);
    }

    private Guid GetPlanIdFromEvent(IEvent evt)
        => evt switch
        {
            PlanStepStartedEvent s => s.PlanId,
            PlanStepCompletedEvent c => c.PlanId,
            _ => Guid.Empty
        };

    private PlanStepUi EnsurePlanStep(Guid planId, int index, string action, string? toolName)
    {
        if (!_livePlans.TryGetValue(planId, out var steps))
        {
            steps = new List<PlanStepUi>();
            _livePlans[planId] = steps;
        }
        while (steps.Count <= index)
            steps.Add(new PlanStepUi { Status = "pending" });
        var step = steps[index];
        if (!string.IsNullOrWhiteSpace(action)) step.Action = action;
        if (!string.IsNullOrWhiteSpace(toolName)) step.Tool = toolName;
        return step;
    }

    private void AttachPlanToLastMessage(Guid planId)
    {
        if (_messages.Count == 0 || _messages[^1].IsUser) return;
        if (_livePlans.TryGetValue(planId, out var steps) && steps.Count > 0)
        {
            _messages[^1].Plan = steps.ToList();
            _messages[^1].ShowPlan = false;
        }
    }

    private Task SafeInvoke(Action action)
    {
        if (_disposed) return Task.CompletedTask;
        try { return InvokeAsync(action); }
        catch { return Task.CompletedTask; }
    }

    private void AttachToolsToLastMessage()
    {
        if (_messages.Count > 0 && !_messages[^1].IsUser && _toolActivities.Count > 0)
        {
            _messages[^1].Tools = _toolActivities.ToList();
            _messages[^1].ShowTools = false;
            _toolActivities.Clear();
        }
    }

    private static readonly Regex QcmOptionRegex = new(
        @"^\s*(?:[A-Ha-h]\s*[\).:]|\d{1,2}\s*[\).:]|[-*]\s*\[[ xX]?\])\s*(.+)$",
        RegexOptions.Multiline | RegexOptions.Compiled);

    private sealed class QcmData
    {
        public string Question { get; init; } = "";
        public List<string> Options { get; init; } = new();
    }

    private QcmData? GetQcm(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || !text.Contains('?')) return null;
        var options = new List<string>();
        var questionLines = new List<string>();
        foreach (var raw in text.Split('\n'))
        {
            var line = raw.Trim();
            if (line.Length == 0) continue;
            var m = QcmOptionRegex.Match(line);
            if (m.Success && options.Count < 8)
            {
                var opt = m.Groups[1].Value.Trim().TrimEnd('?', '.', ' ', '\t').Trim('"', '`', '*');
                if (opt.Length >= 2 && opt.Length <= 160)
                    options.Add(opt);
            }
            else
            {
                questionLines.Add(line);
            }
        }
        if (options.Count < 2) return null;
        return new QcmData { Question = string.Join(" ", questionLines).Trim(), Options = options };
    }

    private async Task SubmitQcmAnswerAsync(string answer)
    {
        if (_isLoading || _isStreaming) return;
        _qcmCustomAnswer = "";
        await SendCoreAsync(answer);
    }

    private async Task SubmitQcmCustomAsync()
    {
        var answer = _qcmCustomAnswer?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(answer)) return;
        await SubmitQcmAnswerAsync(answer);
    }

    private Task OnQcmEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") return SubmitQcmCustomAsync();
        return Task.CompletedTask;
    }

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private void ToggleStepsPanel() => _showSteps = !_showSteps;

    private void DismissStepsPanel() => _activeRecord = null;

    private void ToggleExportMenu() => _showExportMenu = !_showExportMenu;

    private async Task ExportConversation(ConversationExportFormat format)
    {
        _showExportMenu = false;
        var entries = _messages.Select(m => new ConversationExportEntry
        {
            Role = m.IsUser ? "user" : "assistant",
            Content = m.Text.Replace(" [stopped]", ""),
            Timestamp = m.Timestamp,
            Model = m.IsUser ? null : m.Model,
            ToolCallCount = m.IsUser ? 0 : m.ToolCallCount,
            DurationMs = m.IsUser ? null : m.DurationMs,
            AgentDurationMs = m.IsUser ? null : m.AgentDurationMs,
            TokenCount = m.IsUser ? null : m.TokenCount
        }).ToList();

        var content = ExportService.Export(entries, format);
        var base64 = Convert.ToBase64String(ExportService.BuildDownload(content));
        await Js.InvokeVoidAsync("jarvis.downloadFile",
            ConversationExportService.FileName(format),
            ConversationExportService.ContentType(format),
            base64);
        Toasts.ShowSuccess("Export", "Conversation exportée.");
    }

    private void ExportJson(Guid correlationId)
    {
        Nav.NavigateTo($"/api/tasks/{correlationId}/export", forceLoad: true);
    }

    private void OnNewChatRequested()
    {
        if (_disposed) return;
        _ = SafeInvoke(() =>
        {
            _messages.Clear();
            _cancelledMessages.Clear();
            _cancelledExpanded = false;
            _conversation = null;
            _activeRecord = null;
            _sessionId = null;
            _toolActivities.Clear();
            _qcmCustomAnswer = "";
            _isLoading = false;
            _isStreaming = false;
            _streamState = StreamState.Idle;
            _chatEpoch++;
            StateHasChanged();
        });
    }

    private void OnTaskHistoryChanged(object? sender, EventArgs e)
    {
        if (_disposed) return;
        _ = SafeInvoke(() =>
        {
            _activeRecord = TaskHistory.GetActive() ?? TaskHistory.GetRecentHistory(1).FirstOrDefault();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        _toolStartedSub?.Dispose();
        _toolExecutedSub?.Dispose();
        _planCreatedSub?.Dispose();
        _planStepStartedSub?.Dispose();
        _planStepCompletedSub?.Dispose();
        _imageGenSub?.Dispose();
        TaskHistory.Changed -= OnTaskHistoryChanged;
        Downloads.Changed -= OnDownloadsChanged;
        _newChatRequested -= OnNewChatRequested;
    }

