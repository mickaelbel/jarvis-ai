@if (_showDownloadModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" @onclick="CloseDownloadModal">
        <div id="download-modal" class="w-[440px] max-w-full max-h-[82vh] flex flex-col overflow-hidden rounded-2xl bg-surface border border-border shadow-2xl" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between px-4 py-3 border-b border-border">
                <div class="text-sm font-medium text-primary">Télécharger un modèle</div>
                <button class="w-7 h-7 rounded-lg hover:bg-mainbg transition-colors flex items-center justify-center text-muted hover:text-primary bg-transparent border-0 cursor-pointer text-sm" @onclick="CloseDownloadModal" title="Fermer">✕</button>
            </div>
            <div class="px-4 py-3 border-b border-border space-y-2">
                <div class="flex gap-2">
                    <input @bind="_downloadModelName" @bind:event="oninput" placeholder="Nom du modèle (ex. llama3.1)..." class="flex-1 bg-mainbg border border-border rounded-lg px-3 py-2 text-xs text-primary outline-none placeholder:text-muted focus:border-accent" @onkeydown="HandlePullKeyDown" />
                    <button class="px-3 py-2 text-xs font-medium rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-30 border-0 cursor-pointer" @onclick="PullModelByName" disabled="@(string.IsNullOrWhiteSpace(_downloadModelName))">Télécharger</button>
                </div>
                <div>
                    <label for="download-model-search" class="block text-[11px] font-medium text-muted uppercase tracking-wider mb-1">Recherche</label>
                    <div class="relative">
                        <input id="download-model-search" @bind="_downloadSearch" @bind:event="oninput" placeholder="Ex. llama, codage, mistral..." class="w-full bg-mainbg border border-border rounded-lg px-3 py-2 pr-8 text-xs text-primary outline-none placeholder:text-muted focus:border-accent" />
                        @if (!string.IsNullOrEmpty(_downloadSearch))
                        {
                            <button class="absolute right-2 top-1/2 -translate-y-1/2 w-5 h-5 rounded hover:bg-surface flex items-center justify-center text-muted hover:text-primary bg-transparent border-0 cursor-pointer text-xs" @onclick="ClearDownloadSearch" title="Effacer">✕</button>
                        }
                    </div>
                </div>
                @if (!_ollamaOnline)
                {
                    <div class="text-[11px] text-red-400 mt-1">Ollama est hors ligne — démarrez-le pour télécharger un modèle.</div>
                }
            </div>
            <div id="download-model-list" class="flex-1 min-h-0 overscroll-contain overflow-y-auto p-3 space-y-4">
                @if (_activeDownloads.Count > 0)
                {
                    <div class="space-y-2">
                        @foreach (var pull in _activeDownloads)
                        {
                            <div class="p-3 rounded-xl bg-mainbg border border-border">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="text-xs font-medium text-primary">@pull.Model</div>
                                    <button class="text-[11px] text-red-400 hover:bg-red-500/10 rounded-lg px-2 py-1 transition-colors bg-transparent border-0 cursor-pointer" @onclick="() => CancelDownload(pull.Model)">Annuler</button>
                                </div>
                                <div class="jarvis-progress-track mb-1.5">
                                    <div class="jarvis-progress-fill" style="width:@(pull.Percent.ToString("F0"))%"></div>
                                </div>
                                <div class="flex justify-between text-[11px] text-muted">
                                    <span>@pull.Status</span>
                                    <span>@pull.Percent.ToString("F0")%</span>
                                </div>
                                <div class="flex gap-3 text-[10px] text-muted mt-1">
                                    <span>@pull.SizeDisplay</span>
                                    @if (pull.BytesPerSecond > 0)
                                    {
                                        <span>@pull.SpeedDisplay</span>
                                    }
                                    @if (pull.Eta is not null)
                                    {
                                        <span>ETA @pull.EtaDisplay</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (_completedDownloads.Count > 0)
                {
                    <div class="space-y-1.5">
                        <div class="text-[11px] font-medium text-muted uppercase tracking-wider">Récents</div>
                        @foreach (var pull in _completedDownloads)
                        {
                            <div class="flex items-center justify-between px-3 py-2 rounded-lg bg-mainbg border border-border">
                                <span class="text-xs @(pull.Succeeded ? "text-accent" : "text-red-400")">@pull.Model</span>
                                <span class="text-[11px] @(pull.Succeeded ? "text-secondary" : "text-red-400")">@(pull.Succeeded ? "Terminé" : pull.Error)</span>
                            </div>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(_downloadSearch) && _filteredDownloadCatalog.Count == 0)
                {
                    <div class="px-3 py-6 text-center text-xs text-muted">Aucun modèle ne correspond à « @_downloadSearch »</div>
                }
                @if (_filteredDownloadCatalog.Count > 0)
                {
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <div class="text-[11px] font-medium text-muted uppercase tracking-wider">Suggestions @if (!string.IsNullOrEmpty(_downloadSearch)) { <span class="text-accent">(@_filteredDownloadCatalog.Count)</span> }</div>
                        </div>
                        <div class="grid grid-cols-1 gap-1.5">
                            @foreach (var model in _filteredDownloadCatalog)
                            {
                                var isInstalled = _localModels.Any(m => m.Name.StartsWith(model.Name + ":", StringComparison.OrdinalIgnoreCase) || m.Name == model.Name);
                                <div class="px-3 py-2 rounded-lg bg-mainbg border border-border">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="min-w-0">
                                            <div class="text-xs font-medium text-primary truncate">@model.Name</div>
                                            <div class="text-[10px] text-muted truncate">@model.Author · @model.Description</div>
                                        </div>
                                        @if (isInstalled)
                                        {
                                            <span class="text-[10px] font-semibold uppercase tracking-wider text-accent bg-accent/10 px-2 py-0.5 rounded whitespace-nowrap">Installé</span>
                                        }
                                    </div>
                                    @if (!isInstalled && model.Variants.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1.5 mt-2">
                                            @foreach (var v in model.Variants)
                                            {
                                                var variantInstalled = _localModels.Any(m => m.Name.Equals(v.Tag, StringComparison.OrdinalIgnoreCase));
                                                var variantDownloading = Downloads.GetState(v.Tag)?.IsActive == true;
                                                <button class="text-[10px] px-2 py-1 rounded-lg border border-border bg-surface text-secondary hover:border-accent hover:text-accent transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer whitespace-nowrap"
                                                        title="Télécharger @v.Tag"
                                                        @onclick="() => PullModel(v.Tag)" disabled="@(variantInstalled || variantDownloading)">
                                                    @v.SizeLabel@(string.IsNullOrEmpty(v.DownloadLabel) ? "" : $" · {v.DownloadLabel}")
                                                    @(variantInstalled ? " ✓" : variantDownloading ? " …" : "")
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? SessionId { get; set; }

    private List<ChatMessage> _messages = new();
    private string? _sessionId;
    private AIConversation? _conversation;
    private string _input = "";
    private readonly List<string> _sentHistory = new();
    private int _historyIndex = -1;
    private bool _isLoading;
    private bool _isStreaming;
    private bool _preparing;
    private StreamState _streamState = StreamState.Idle;
    private readonly System.Diagnostics.Stopwatch _genStopwatch = new();
    private int _toolCallCount;
    private bool _inputFocused;
    private ElementReference _chatInput;
    private InputFile? _fileInput;
    private List<UploadedImage> _uploadedImages = new();

    /// <summary>Messages annulés lors d'un « Revenir » — affichés dans une
    /// bannière repliable au-dessus du champ de saisie, restaurables.</summary>
    private readonly List<CancelledMessage> _cancelledMessages = new();
    private bool _cancelledExpanded;

    private bool _ollamaOnline;
    private string? _selectedModel;
    private List<OllamaLocalModel> _localModels = new();
    private bool _showModelDropdown;
    private string _modelSearch = "";
    private bool _searchExpanded;
    private List<OllamaLocalModel> _toolModels =>
        _localModels.Where(m => ModelCapabilities.SupportsTools(m.Name)).ToList();
    private List<ModelChoice> _modelChoices => BuildModelChoices();
    private List<ModelChoice> _filteredModels =>
        string.IsNullOrWhiteSpace(_modelSearch)
            ? _modelChoices
            : _modelChoices.Where(m => m.Name.Contains(_modelSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private sealed record ModelChoice(string Name, string Source, bool Installed, string Size);

    private List<ModelChoice> BuildModelChoices()
    {
        var choices = new List<ModelChoice>();
        foreach (var m in _toolModels)
            choices.Add(new ModelChoice(m.Name, "local", true, m.SizeDisplay));
        foreach (var m in _cloudModels)
            if (choices.All(c => c.Name != m))
                choices.Add(new ModelChoice(m, "cloud", true, "Cloud"));
        foreach (var c in _downloadCatalog)
        {
            var baseName = c.Name.Trim().Split(':')[0];
            if (choices.Any(ch => ch.Name.Trim().Split(':')[0].Equals(baseName, StringComparison.OrdinalIgnoreCase)))
                continue;
            choices.Add(new ModelChoice(c.Name, "catalog", false, c.DownloadSize));
        }
        return choices;
    }

    private const string ModelPrefKey = "jarvis.selectedModel";

    private bool _smartRoutingEnabled = true;
    private string? _manualOverride;
    private SmartRoute? _lastRoute;
    private string? DisplayModel => _manualOverride ?? (IsAutoMode ? "Auto" : _selectedModel);
    private bool IsAutoMode => _manualOverride == null && _smartRoutingEnabled;

    private bool _showDownloadModal;
    private string _downloadModelName = "";
    private string _downloadSearch = "";
    private List<OllamaCatalogModel> _downloadCatalog = new();
    private List<string> _cloudModels = new();
    private List<ModelDownloadState> _activeDownloads = new();

    private bool _showImageGenModal;
    private string _imageGenPrompt = "";
    private bool _imageGenLoading;
    private string? _imageGenResult;
    private string? _imageGenError;
    private List<ModelDownloadState> _completedDownloads = new();
    private bool _hadActiveDownloads;
    private List<OllamaCatalogModel> _filteredDownloadCatalog =>
        string.IsNullOrWhiteSpace(_downloadSearch)
            ? _downloadCatalog
            : _downloadCatalog.Where(m =>
                m.Name.Contains(_downloadSearch, StringComparison.OrdinalIgnoreCase) ||
                m.Description.Contains(_downloadSearch, StringComparison.OrdinalIgnoreCase) ||
                m.Author.Contains(_downloadSearch, StringComparison.OrdinalIgnoreCase) ||
                m.Tags.Any(t => t.Contains(_downloadSearch, StringComparison.OrdinalIgnoreCase))).ToList();

    private string? _pendingInstallModel;
    private string? _pendingInstallText;
    private OllamaCatalogModel? _pendingInstallSuggestion;
    private bool _isInstallingModel;
    private ModelDownloadState? _installState;
    private TaskCompletionSource<bool>? _installTcs;

    private readonly List<ToolActivity> _toolActivities = new();
    private string _qcmCustomAnswer = "";
    private bool _disposed;
    private int _chatEpoch;

    /// <summary>Événement statique : NavMenu/Historique demandent un « Nouveau
    /// chat » — le composant Chat actif (s'il existe) se vide immédiatement.</summary>
    private static Action? _newChatRequested;
    public static void RequestNewChat() => _newChatRequested?.Invoke();
    private static bool _circuitInitialized;
    private int _activeEpoch;
