                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                        </button>
                        <button class="w-8 h-8 rounded-lg hover:bg-mainbg transition-colors flex items-center justify-center text-muted hover:text-primary bg-transparent border-0 cursor-pointer" title="Générer une image (Prompt → Image gratuit)" @onclick="OpenImageGenModal">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/><path d="M4 19h16" opacity="0.3"/></svg>
