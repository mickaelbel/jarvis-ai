@page "/"
@page "/chat"
@page "/chat/{SessionId}"
@using System.Net
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR
@using JarvisAI.Application.AI
@using JarvisAI.Application.Tools
@using JarvisAI.Application.Agents
@using JarvisAI.Application.Abstractions
@using JarvisAI.Application.Vision
@using JarvisAI.Domain.Events.Agents
@using JarvisAI.Domain.Events.Planning
@using JarvisAI.Domain.Events
@using JarvisAI.Infrastructure.AI
@using JarvisAI.Web.Services
@inject IAIService AIService
@inject IToolRegistry ToolRegistry
@inject IVisionService VisionService
@inject JarvisAI.Application.Vision.IImageGenerationService ImageGenService
@inject IAgentOrchestrator Orchestrator
@inject IMultiAgentOrchestrator MultiAgent
@inject JarvisAI.Application.Agents.Supervision.IAgentSupervisor Supervisor
@inject NavigationManager Nav
@inject OllamaModelService OllamaService
@inject ModelDownloadProgressService Downloads
@inject ActionHistoryService HistoryService
@inject ConversationSessionService Sessions
@inject JarvisAI.Infrastructure.Dev.ITurnHistory Turns
@inject MarkdownRenderer MdRenderer
@inject ITaskExecutionHistory TaskHistory
@inject IEventBus EventBus
@inject GenerationSession Generation
@inject ConversationExportService ExportService
@inject ToastService Toasts
@inject OllamaRunMonitor RunMonitor
@inject ModelRecommendationService Recommendations
@inject SmartRoutingStore SmartRouting
@inject ConversationCondenser Condenser
@inject System.Collections.Generic.IEnumerable<IAIProvider> Providers
@inject JarvisAI.Application.Memory.IEpisodicMemoryService Episodes
@inject Microsoft.AspNetCore.SignalR.IHubContext<JarvisAI.Web.Hubs.OverlayHub> OverlayHubCtx
@implements IDisposable
@rendermode InteractiveServer

<div class="flex flex-col h-full bg-mainbg">
    @if (_messages.Count > 0)
    {
        <div class="flex-shrink-0 flex items-center justify-between px-4 pt-3 pb-1">
            <div class="flex items-center gap-2">
                <div class="text-xs text-muted">@_messages.Count(m => !m.IsUser) response@(_messages.Count(m => !m.IsUser) != 1 ? "s" : "")</div>
                @if (_lastRoute?.DownloadSuggestion is { } suggestion)
                {
                    <button class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-medium bg-accent/10 text-accent hover:bg-accent/20 transition-colors border-0 cursor-pointer"
                            title="Modèle recommandé pour cette requête (@_lastRoute.Reason)" @onclick="() => DownloadSuggested(suggestion.Name)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Télécharger @suggestion.Name
                    </button>
                }
            </div>
            <div class="relative" @onclick="ToggleExportMenu" @onclick:stopPropagation="true">
                <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs text-secondary hover:text-primary hover:bg-surface transition-colors border border-border bg-transparent cursor-pointer" title="Export conversation">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Export
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                @if (_showExportMenu)
                {
                    <div class="absolute right-0 top-full mt-1 w-44 bg-surface border border-border rounded-xl shadow-2xl z-50 overflow-hidden" @onclick:stopPropagation="true">
                        @foreach (var (format, label) in ExportOptions)
                        {
                            <button class="w-full flex items-center gap-2 px-3 py-2 text-xs text-left hover:bg-mainbg transition-colors text-secondary bg-transparent border-0 cursor-pointer"
                                    @onclick="() => ExportConversation(format)">
                                <span class="text-[10px] font-bold text-accent bg-accent/10 px-1.5 py-0.5 rounded">@label</span>
                                @(label + " file")
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }
    @if (_messages.Count == 0)
    {
        <div class="flex-1 flex items-center justify-center">
            <div class="text-center max-w-md px-4">
                <img src="/favicon.png" alt="Jarvis" class="w-12 h-12 mx-auto mb-4 rounded-xl object-cover shadow-lg" />
                <h1 class="text-2xl font-semibold text-primary mb-1">How can I help you?</h1>
                <p class="text-sm text-muted">Ask me anything — I'm connected to Ollama</p>
            </div>
        </div>
    }
    else
    {
        <div id="chat-messages" class="flex-1 overflow-y-auto">
            <div class="max-w-chat mx-auto px-4 py-6">
                @foreach (var msg in _messages)
                {
                    <div class="mb-6 group @(msg.IsUser ? "flex justify-end" : "")">
                        @if (msg.IsUser)
                        {
                            @if (_editingMessage == msg)
                            {
                                <div class="flex flex-col items-end gap-2 max-w-[75%]">
                                    <textarea @bind="_editText" rows="2" class="w-full bg-surface border border-border rounded-2xl px-4 py-3 text-sm text-primary outline-none placeholder:text-muted focus:border-accent resize-none" style="min-height:60px;"></textarea>
                                    <div class="flex items-center gap-2">
                                        <button class="text-xs px-3 py-1 rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors border-0 cursor-pointer" @onclick="SaveEdit">Save</button>
                                        <button class="text-xs px-3 py-1 rounded-lg bg-surface text-muted hover:text-primary transition-colors border border-border cursor-pointer" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="max-w-[75%]">
                                <div class="md bg-surface text-primary rounded-2xl rounded-br-sm px-4 py-3 whitespace-pre-wrap text-sm leading-relaxed">
                                    @((MarkupString)msg.HtmlContent)
                                </div>
                                    @if (!_isLoading && !_isStreaming && !_rewinding)
                                    {
                                        <div class="flex items-center justify-end gap-3 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                            @if (msg == _messages.Last())
                                            {
                                                <button class="text-xs text-muted hover:text-primary transition-colors bg-transparent border-0 cursor-pointer flex items-center gap-1" @onclick="() => EditLastMessage(msg)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                                    Edit
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="text-xs text-muted hover:text-primary transition-colors bg-transparent border-0 cursor-pointer flex items-center gap-1"
                                                        title="Modifie cette demande après avoir annulé tout ce qui a suivi (fichiers inclus)"
                                                        @onclick="() => RewindTo(msg, prefillForEdit: true)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
                                                    Modifier
                                                </button>
                                            }
                                            <button class="text-xs text-muted hover:text-accent transition-colors bg-transparent border-0 cursor-pointer flex items-center gap-1"
                                                    title="Annule ce tour et tout ce qui a suivi — y compris les modifications de fichiers de Jarvis"
                                                    @onclick="() => RewindTo(msg, prefillForEdit: false)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
                                                Revenir
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="max-w-full text-sm leading-relaxed">
                                <div class="md text-primary/90 @(msg == _messages.Last() && _isStreaming ? "streaming-cursor" : "")">
                                    @((MarkupString)msg.HtmlContent)
                                </div>
                                @if (msg.GeneratedImages is { Count: > 0 } genImages)
                                {
                                    <div class="mt-3 space-y-3">
                                        @foreach (var gi in genImages)
                                        {
                                            <div class="rounded-xl border border-border overflow-hidden bg-surface max-w-md">
                                                <img src="@gi.DataUrl" class="w-full object-contain block" alt="Image générée" />
                                                <div class="px-3 py-2 flex items-center gap-2 border-t border-border">
                                                    <span class="flex-1 text-[11px] text-muted truncate" title="@gi.FilePath">@gi.Prompt</span>
                                                    <button class="text-[11px] text-accent hover:text-accent-hover bg-transparent border-0 cursor-pointer font-medium"
                                                            @onclick="() => DownloadGeneratedMessageImage(gi)" title="Télécharger l'image">Télécharger</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(msg.Text))
                                {
                                    <div class="flex items-center gap-2 mt-2">
                                        <button class="text-xs text-muted hover:text-primary transition-colors bg-transparent border-0 cursor-pointer flex items-center gap-1" @onclick="() => Copy(msg.Text)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                            Copy
                                        </button>
                                        <button class="text-xs text-muted hover:text-primary transition-colors bg-transparent border-0 cursor-pointer flex items-center gap-1" @onclick="() => Speak(msg.Text)" title="Lire la réponse à voix haute">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                                            Parler
                                        </button>
                                        @if (msg == _messages.Last() && !_isLoading && !_isStreaming)
                                        {
                                            <button class="text-xs text-muted hover:text-primary transition-colors bg-transparent border-0 cursor-pointer flex items-center gap-1" @onclick="Regenerate" title="Regenerate response">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                                                Regenerate
                                            </button>
                                            @if (msg.Text.EndsWith(" [stopped]", StringComparison.Ordinal))
                                            {
                                                <button class="text-xs text-accent hover:text-accent-hover transition-colors bg-transparent border-0 cursor-pointer flex items-center gap-1" @onclick="Resume" title="Resume interrupted response">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                                    Resume
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                                @if (msg == _messages.Last() && !_isLoading && !_isStreaming)
                                {
                                    <AIResponseMetadata Model="@msg.Model" DurationMs="@msg.DurationMs"
                                                         TokenCount="@msg.TokenCount" ToolCallCount="@msg.ToolCallCount"
                                                         AgentDurationMs="@msg.AgentDurationMs" />
                                }
                                @if (msg.Tools is { Count: > 0 } msgTools)
                                {
                                    <div class="mt-3 rounded-xl bg-surface border border-border overflow-hidden max-w-xl">
                                        <button class="w-full flex items-center gap-2 px-3 py-2 cursor-pointer select-none bg-transparent border-0 text-left" @onclick="() => msg.ShowTools = !msg.ShowTools">
                                            <span class="flex items-center gap-2 text-xs font-medium text-primary flex-shrink-0">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                                                <span>Tools utilisés</span>
                                                <span class="text-muted font-normal">@msgTools.Count</span>
                                            </span>
                                            <span class="flex items-center gap-2 min-w-0 flex-1 justify-end">
                                                <span class="text-xs font-medium text-accent truncate">@msgTools[^1].ToolName</span>
                                                <span class="text-muted text-xs flex-shrink-0">@(msg.ShowTools ? "▾" : "▸")</span>
                                            </span>
                                        </button>
                                        @if (msg.ShowTools)
                                        {
                                            <div class="px-3 pb-3 space-y-2 max-h-64 overflow-y-auto">
                                                @foreach (var act in msgTools)
                                                {
                                                    <div class="text-xs">
                                                        <div class="flex items-center gap-2">
                                                            @if (act.Status == "running")
                                                            {
                                                                <span class="w-3 h-3 rounded-full border-2 border-accent border-t-transparent animate-spin inline-block"></span>
                                                            }
                                                            else if (act.Status == "done")
                                                            {
                                                                <span class="text-accent">✓</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-red-400">✗</span>
                                                            }
                                                            <span class="font-medium text-primary">@act.ToolName</span>
                                                            @if (act.Args.Count > 0)
                                                            {
                                                                <span class="text-muted truncate">@string.Join(", ", act.Args.Select(kv => $"{kv.Key}={kv.Value}"))</span>
                                                            }
                                                            @if (act.Status != "running")
                                                            {
                                                                <span class="text-muted">· @act.DurationMs.ToString("F0") ms</span>
                                                            }
                                                        </div>
                                                        @if (act.Status == "done" && !string.IsNullOrEmpty(act.Result))
                                                        {
                                                            <div class="ml-5 text-xs text-muted line-clamp-2">@act.Result</div>
                                                        }
                                                        @if (act.Status == "error" && !string.IsNullOrEmpty(act.Error))
                                                        {
                                                            <div class="ml-5 text-xs text-red-400 line-clamp-2">@act.Error</div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (msg.Plan is { Count: > 0 } planSteps)
                                {
                                    <div class="mt-3 rounded-xl bg-surface border border-border overflow-hidden max-w-xl">
                                        <button class="w-full flex items-center gap-2 px-3 py-2 cursor-pointer select-none bg-transparent border-0 text-left" @onclick="() => msg.ShowPlan = !msg.ShowPlan">
                                            <span class="flex items-center gap-2 text-xs font-medium text-primary flex-shrink-0">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                                                <span>Plan</span>
                                                <span class="text-muted font-normal">@(planSteps.Count(s => s.Status == "done") + "/" + planSteps.Count)</span>
                                            </span>
                                            <span class="ml-auto text-muted text-xs flex-shrink-0">@(msg.ShowPlan ? "▾" : "▸")</span>
                                        </button>
                                        @if (msg.ShowPlan)
                                        {
                                            <div class="px-3 pb-3 space-y-1 max-h-64 overflow-y-auto">
                                                @foreach (var step in planSteps)
                                                {
                                                    <div class="flex items-start gap-2 text-xs">
                                                        @if (step.Status == "running")
                                                        {
                                                            <span class="w-3 h-3 rounded-full border-2 border-accent border-t-transparent animate-spin inline-block mt-0.5"></span>
                                                        }
                                                        else if (step.Status == "done")
                                                        {
                                                            <span class="text-accent mt-0.5">✓</span>
                                                        }
                                                        else if (step.Status == "error")
                                                        {
                                                            <span class="text-red-400 mt-0.5">✗</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted mt-0.5">○</span>
                                                        }
                                                        <span class="text-primary">@step.Action</span>
                                                        @if (!string.IsNullOrEmpty(step.Tool))
                                                        {
                                                            <span class="text-accent text-[11px] flex-shrink-0">@step.Tool</span>
                                                        }
                                                        @if (step.Status == "done")
                                                        {
                                                            <span class="text-muted">· @step.DurationMs.ToString("F0") ms</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (msg == _messages.Last() && !_isLoading && !_isStreaming && GetQcm(msg.Text) is { } qcm)
                                {
                                    <div class="mt-3 rounded-xl bg-surface border border-border p-3 max-w-xl">
                                        <div class="text-xs font-medium text-muted mb-2">Répondre au QCM</div>
                                        <div class="space-y-2">
                                            @foreach (var opt in qcm.Options)
                                            {
                                                <button class="w-full text-left text-xs bg-mainbg/60 hover:bg-accent/10 border border-border hover:border-accent rounded-lg px-3 py-2 text-primary transition-colors cursor-pointer"
                                                        @onclick="() => SubmitQcmAnswerAsync(opt)">
                                                    @opt
                                                </button>
                                            }
                                        </div>
                                        <div class="flex items-center gap-2 mt-3">
                                            <input @bind="_qcmCustomAnswer" @onkeydown="OnQcmEnterAsync"
                                                   placeholder="Écrire votre propre réponse..." 
                                                   class="flex-1 bg-mainbg border border-border rounded-lg px-3 py-2 text-xs text-primary outline-none placeholder:text-muted focus:border-accent" />
                                            <button class="text-xs px-3 py-2 rounded-lg bg-accent hover:bg-accent-hover text-white border-0 cursor-pointer" @onclick="SubmitQcmCustomAsync">
                                                Envoyer
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_isLoading || _isStreaming)
                {
                    <div class="mb-6">
                        <div class="flex items-center gap-3 px-1 py-2">
                            <div class="jarvis-status-pill">
                                <span class="dot"></span>
                                @StatusLabel
                            </div>
                        </div>
                    </div>
                }
                @if (_pendingInstallModel is { } pendingModel)
                {
                    <div class="mb-6 p-4 rounded-xl bg-surface border border-border">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent flex-shrink-0">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="text-sm font-medium text-primary">
                                    @if (_isInstallingModel)
                                    {
                                        <span>Installation de <span class="text-accent">@pendingModel</span>...</span>
                                    }
                                    else
                                    {
                                        <span>Le modèle <span class="text-accent">@pendingModel</span> est requis pour cette tâche mais n'est pas installé</span>
                                    }
                                </div>
                                @if (_pendingInstallSuggestion is { } suggestion)
                                {
                                    <div class="text-xs text-muted mt-1">
                                        @suggestion.Description
                                        @if (!string.IsNullOrEmpty(suggestion.DownloadSize))
                                        {
                                            <span class="ml-1">· @suggestion.DownloadSize</span>
                                        }
                                    </div>
                                    @if (suggestion.Variants.Count > 1)
                                    {
                                        <div class="text-[11px] text-muted mt-1">La taille la plus légère sera installée : <span class="text-accent">@suggestion.Variants[0].Tag</span> (@suggestion.Variants[0].DownloadLabel)</div>
                                    }
                                }
                                @if (_installState is { } installState)
                                {
                                    <div class="mt-3">
                                        <div class="flex items-center justify-between text-xs text-muted mb-1">
                                            <span>@installState.Status</span>
                                            <span>@installState.Percent.ToString("F0")%</span>
                                        </div>
                                        <div class="h-2 bg-mainbg rounded-full overflow-hidden">
                                            <div class="h-full bg-accent transition-all duration-300" style="width:@installState.Percent.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                        </div>
                                        <div class="text-[11px] text-muted mt-1">
                                            @installState.SizeDisplay @installState.SpeedDisplay @installState.EtaDisplay
                                        </div>
                                    </div>
                                }
                                else if (!_isInstallingModel)
                                {
                                    <div class="mt-3 flex items-center gap-2">
                                        <button class="bg-accent hover:bg-accent-hover text-white rounded-lg px-4 py-2 text-xs font-medium border-0 cursor-pointer" @onclick="InstallAndContinue">
                                            Installer et continuer
                                        </button>
                                        <button class="text-xs text-muted hover:text-primary transition-colors bg-transparent border-0 cursor-pointer" @onclick="SkipInstall">
                                            Continuer avec un modèle déjà installé
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }



    <div class="flex-shrink-0 px-4 pb-4 pt-2">
        <div class="max-w-chat mx-auto">
            @if (_cancelledMessages.Count > 0)
            {
                <div class="mb-2 rounded-xl bg-surface border border-border overflow-hidden">
                    <button class="w-full flex items-center gap-2 px-3 py-2 cursor-pointer select-none bg-transparent border-0 text-left"
                            @onclick="() => { _cancelledExpanded = !_cancelledExpanded; }"
                            title="Afficher/masquer les messages annulés">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" class="text-muted flex-shrink-0"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
                        <span class="text-xs font-medium text-primary flex-shrink-0">@(_cancelledMessages.Count) @(_cancelledMessages.Count == 1 ? "message" : "messages") annulé@(_cancelledMessages.Count == 1 ? "" : "s")</span>
                        <span class="text-[11px] text-muted truncate">@_cancelledMessages[0].Text</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" class="text-muted flex-shrink-0 ml-auto transition-transform @(_cancelledExpanded ? "rotate-180" : "")"><polyline points="6 15 12 9 18 15"/></svg>
                    </button>
                    @if (_cancelledExpanded)
                    {
                        <div class="border-t border-border divide-y divide-border max-h-56 overflow-y-auto">
                            @foreach (var cm in _cancelledMessages)
                            {
                                <div class="flex items-center gap-2 px-3 py-2">
                                    <span class="text-[11px] text-muted uppercase flex-shrink-0">User</span>
                                    <span class="text-xs text-primary/90 truncate">@cm.Text</span>
                                    <button class="ml-auto flex-shrink-0 text-[11px] text-accent hover:text-accent-hover hover:bg-accent/10 rounded-lg px-2 py-1 transition-colors bg-transparent border-0 cursor-pointer"
                                            @onclick="() => RestoreCancelled(cm)"
