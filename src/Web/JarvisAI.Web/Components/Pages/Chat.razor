    private async Task InstallAndContinue()
    {
        if (_pendingInstallModel is null || _isInstallingModel) return;

        _isInstallingModel = true;
        _installState = null;
        _installTcs = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        StateHasChanged();
        await Scroll();

        var target = _pendingInstallModel;
        if (!target.Contains(':'))
        {
            var catalog = OllamaModelService.FindCatalogModel(target);
            if (catalog is { Variants.Count: > 0 }) target = catalog.Variants[0].Tag;
            _pendingInstallModel = target;
        }
        var started = await Downloads.StartPullAsync(target);
        if (!started)
        {
            var existing = Downloads.GetState(_pendingInstallModel);
            if (existing is { IsActive: false })
            {
                await FinishInstallAsync(existing.Succeeded);
                return;
            }
        }

        var tcs = _installTcs;
        try
        {
            var success = await tcs.Task;
            await FinishInstallAsync(success);
        }
        catch (TaskCanceledException)
        {
            await FinishInstallAsync(false);
        }
    }

    private async Task FinishInstallAsync(bool success)
    {
        var text = _pendingInstallText ?? "";
        var model = _pendingInstallModel;
        _pendingInstallModel = null;
        _pendingInstallText = null;
        _pendingInstallSuggestion = null;
        _isInstallingModel = false;
        _installState = null;
        _installTcs = null;

        if (!success)
        {
            Toasts.ShowError("Installation", $"L'installation du modèle {model} a échoué.");
            StateHasChanged();
            return;
        }

        _localModels = await OllamaService.GetLocalModelsAsync();
        EnsureToolsCapableSelection();
        StateHasChanged();
        await StreamResponseAsync(text, model);
    }

    private async Task SkipInstall()
    {
        if (_pendingInstallModel is null) return;

        var text = _pendingInstallText ?? "";
        var model = _pendingInstallModel;
        _pendingInstallModel = null;
        _pendingInstallText = null;
        _pendingInstallSuggestion = null;
        _isInstallingModel = false;
        _installState = null;
        StateHasChanged();
        await StreamResponseAsync(text, model);
    }

