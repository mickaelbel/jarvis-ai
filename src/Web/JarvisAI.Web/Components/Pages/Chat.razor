    private enum StreamState { Idle, Thinking, Generating, ToolExecution, Completed, Failed }

    private string StatusLabel => _streamState switch
    {
        StreamState.Thinking => !string.IsNullOrWhiteSpace(_loadingMessage) ? _loadingMessage : "Jarvis réfléchit...",
        StreamState.Generating => "Jarvis écrit...",
        StreamState.ToolExecution => "Exécution d'un outil...",
        StreamState.Failed => "Erreur rencontrée",
        _ => "Génération..."
    };

    private string _loadingMessage = "";
    private const string FirstMessagePreparingStatus = "Préparation de la réponse...";

    protected override async Task OnInitializedAsync()
    {
        _toolStartedSub = EventBus.Subscribe<AgentToolStartedEvent>(OnToolStartedAsync);
        _toolExecutedSub = EventBus.Subscribe<AgentToolExecutedEvent>(OnToolExecutedAsync);
        _planCreatedSub = EventBus.Subscribe<PlanCreatedEvent>(OnPlanCreatedAsync);
        _planStepStartedSub = EventBus.Subscribe<PlanStepStartedEvent>(OnPlanStepAsync);
        _planStepCompletedSub = EventBus.Subscribe<PlanStepCompletedEvent>(OnPlanStepAsync);
        _imageGenSub = EventBus.Subscribe<ImageGeneratedEvent>(OnImageGeneratedAsync);
        TaskHistory.Changed += OnTaskHistoryChanged;
        Downloads.Changed += OnDownloadsChanged;
        _newChatRequested += OnNewChatRequested;
        _downloadCatalog = OllamaModelService.GetCatalog();
        _cloudModels = LoadConfiguredCloudModels();
        _smartRoutingEnabled = SmartRouting.Get().Enabled;
        _activeRecord = TaskHistory.GetActive();
        var wantsNew = Nav.ToAbsoluteUri(Nav.Uri).Query.Contains("new=1");
        var freshCircuit = !_circuitInitialized;
        _circuitInitialized = true;
        if (wantsNew || freshCircuit)
        {
            // Nouvelle conversation (new=1) ou lancement à froid : on force un chat
            // VIDE. Jamais de reprise de session ici, même si l'URL porte un {SessionId}.
            _messages.Clear();
            _cancelledMessages.Clear();
            _cancelledExpanded = false;
            _conversation = null;
            _activeRecord = null;
            _sessionId = null;
        }
        else if (!string.IsNullOrEmpty(SessionId))
        {
            var session = Sessions.GetById(SessionId);
            if (session is not null)
            {
                _sessionId = session.Id;
                LoadSessionIntoUi(session);
            }
        }
        else
        {
            // TOUJOURS démarrer avec un chat vide au lancement de l'app.
            // L'utilisateur peut reprendre une ancienne conv via l'historique.
            _messages.Clear();
            _cancelledMessages.Clear();
            _cancelledExpanded = false;
            _conversation = null;
            _activeRecord = null;
            _sessionId = null;
        }
        await CheckOllama();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var isNew = uri.Query.Contains("new=1");
        var targetSession = SessionId;
        if (isNew || (!string.IsNullOrEmpty(targetSession) && targetSession != _sessionId))
        {
            _chatEpoch++;
            if (isNew)
            {
                _messages.Clear();
                _cancelledMessages.Clear();
                _cancelledExpanded = false;
                _conversation = null;
                _activeRecord = null;
                _sessionId = null;
                _toolActivities.Clear();
                _qcmCustomAnswer = "";
                _isLoading = false;
                _isStreaming = false;
                _streamState = StreamState.Idle;
            }
            else if (!string.IsNullOrEmpty(targetSession))
            {
                var session = Sessions.GetById(targetSession);
                if (session is not null)
                {
                    _sessionId = session.Id;
                    LoadSessionIntoUi(session);
                }
            }
            StateHasChanged();
        }
        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            await JsSafeAsync("jarvis.focusInput", "chat-input");
            await LoadSelectedModelAsync();
        }
        if (_messages.Count > 0)
        {
            // best-effort, borné dans le temps : un WebView2 qui n'acquitte pas ces
            // appels ne doit pas geler le circuit (clics) ni le pill « Jarvis écrit... ».
            await JsSafeAsync("jarvis.scrollToBottom", "chat-messages");
            await JsSafeAsync("jarvis.highlightCode");
            await JsSafeAsync("jarvis.renderMath");
        }
    }

    /// <summary>Garde la sélection sur un modèle compatible outils ; sinon choisit
    /// le premier modèle disponible compatible (les modèles vision/embeddings sont
    /// exclus du sélecteur de chat).</summary>
    private void EnsureToolsCapableSelection()
    {
        var tools = _toolModels;
        if (tools.Count == 0)
        {
            _selectedModel = null;
            return;
        }
        if (_selectedModel is null || !tools.Any(m => m.Name == _selectedModel))
            _selectedModel = tools[0].Name;
    }

    private async Task LoadSelectedModelAsync()
    {
        try
        {
            var pref = await Js.InvokeAsync<string>("jarvis.getPref", ModelPrefKey);
            if (!string.IsNullOrWhiteSpace(pref) && _toolModels.Any(m => m.Name == pref))
            {
                _selectedModel = pref;
                StateHasChanged();
            }
        }
        catch
        {
            // interop indisponible : on garde la sélection par défaut.
        }
    }

    private async Task CheckOllama()
    {
        _ollamaOnline = await OllamaService.IsAvailableAsync();
        if (_ollamaOnline)
        {
            _localModels = await OllamaService.GetLocalModelsAsync();
            EnsureToolsCapableSelection();
        }
    }

    private List<string> LoadConfiguredCloudModels()
    {
        try
        {
            return Providers
                .Where(p => p is not OllamaProvider && p is not RoutingProvider && p.IsAvailable)
                .SelectMany(p => p.KnownModels)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            return new List<string>();
        }
    }

    private async Task<bool> StartOllama(CancellationToken ct = default)
    {
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = "ollama", Arguments = "serve",
                UseShellExecute = true, CreateNoWindow = true,
                WindowStyle = System.Diagnostics.ProcessWindowStyle.Hidden
            });
            try { await Task.Delay(3000, ct); } catch (OperationCanceledException) { return false; }
            for (int i = 0; i < 5; i++)
            {
                if (ct.IsCancellationRequested) return false;
                if (await OllamaService.IsAvailableAsync(ct)) return true;
                try { await Task.Delay(2000, ct); } catch (OperationCanceledException) { return false; }
            }
            return await OllamaService.IsAvailableAsync(ct);
        }
        catch (OperationCanceledException) { return false; }
        catch { return await OllamaService.IsAvailableAsync(ct); }
    }

    private async Task ResizeInput()
    {
        if (_chatInput.Id is not null)
        {
            await JsSafeAsync("jarvis.autoResize", _chatInput);
        }
    }

    private async Task Send()
    {
        // Un envoi pendant une génération en cours déclenche un streaming
        // concurrent qui manipule la même liste _messages → messages dupliqués
        // persistants. On bloque donc l'envoi tant qu'une réponse n'est pas finie.
        if (_isLoading || _isStreaming || _preparing) return;
        if (string.IsNullOrWhiteSpace(_input)) return;
        var text = _input.Trim();
        _input = "";
        await SendCoreAsync(text);
    }

    private async Task SendCoreAsync(string text)
    {
        // Barge-in : l'envoi reste permis pendant qu'une génération est en cours.
        // Le nouveau message NE CANCÈLE PAS l'action en cours : il démarre sa
        // propre génération sur un snapshot, l'ancienne continue en arrière-plan.
        if (string.IsNullOrWhiteSpace(text)) return;

        // Démarre immédiatement la session de génération (CTS annulable via le bouton
        // Stop) pour que la préparation — Ollama, modèles, rappel mémoire — soit
        // interruptible au lieu de laisser l'interface figée sans moyen d'arrêter.
        Generation.Start();
        var genToken = Generation.Token;
        _preparing = true;

        if (!_ollamaOnline)
        {
            _streamState = StreamState.Thinking;
            _loadingMessage = "Démarrage d'Ollama...";
            StateHasChanged();
            await Scroll();

            _ollamaOnline = await StartOllama(genToken);
            if (!_ollamaOnline || genToken.IsCancellationRequested)
            {
                EndPreparation(genToken);
                return;
            }

            _loadingMessage = "Chargement de la liste des modèles...";
            StateHasChanged();
            await Scroll();
            _localModels = await OllamaService.GetLocalModelsAsync(genToken);
            EnsureToolsCapableSelection();
        }
        if (genToken.IsCancellationRequested)
        {
            EndPreparation(genToken);
            return;
        }

        if (_sentHistory.Count == 0 || _sentHistory[^1] != text)
            _sentHistory.Add(text);
        if (_sentHistory.Count > 50) _sentHistory.RemoveAt(0);
        _historyIndex = -1;

        if (text.StartsWith("/auto ", StringComparison.OrdinalIgnoreCase))
        {
            // Le mode /auto gère son propre cycle de génération (token dédié).
            _preparing = false;
            Generation.Complete(genToken);
            await RunAutonomousAsync(text["/auto ".Length..].Trim(), text);
            return;
        }

        if (_uploadedImages.Count > 0)
        {
            var captions = new List<string>();
            foreach (var img in _uploadedImages)
            {
                if (string.IsNullOrEmpty(img.Caption))
                {
                    try
                    {
                        var desc = await VisionService.DescribeImageAsync(img.Bytes, "Describe this image in one short sentence.");
                        img.Caption = desc?.Description ?? string.Empty;
                    }
                    catch { img.Caption = string.Empty; }
                }
                if (!string.IsNullOrEmpty(img.Caption))
                    captions.Add(img.Caption);
            }
            if (captions.Count > 0)
                text = $"[Image: {string.Join(" | ", captions)}]\n\n{text}";
            _uploadedImages.Clear();
            StateHasChanged();
        }

        _conversation ??= new AIConversation(AgentSystemPrompt.Build(ToolDefinitionBuilder.Build(ToolRegistry)));

        var userMessage = new ChatMessage(text, true, MdRenderer.Render(text));
        _messages.Add(userMessage);

        // Feedback immédiat : on passe en « chargement » tout de suite pour que
        // l'utilisateur voie que le message a bien été pris en compte, avant même
        // le démarrage du modèle / le rappel de mémoire (qui peuvent prendre
        // plusieurs secondes, surtout au premier message).
        _isLoading = true;
        _isStreaming = false;
        _streamState = StreamState.Thinking;
        _loadingMessage = FirstMessagePreparingStatus;
        StateHasChanged();
        await Scroll();

        EnsureSession();
        Sessions.AppendMessage(_sessionId!, "user", text, _selectedModel ?? "");

        HistoryService.AddEntry(new HistoryEntry
        {
            Type = "chat", Title = "User",
            Description = text.Length > 100 ? text[..100] + "..." : text,
            Status = "info"
        });

        var model = await ResolveModelAsync(text, genToken);

        if (genToken.IsCancellationRequested)
        {
            EndPreparation(genToken);
            return;
        }

        // Réduit le cold-start : on signale le chargement du modèle résolu pendant la
        // préparation, pour que le premier token arrive plus vite au streaming.
        if (!string.IsNullOrWhiteSpace(model))
        {
            _loadingMessage = $"Chargement du modèle {model}...";
            StateHasChanged();
            await Scroll();
        }

        if (ShouldProposeInstallAsync(model))
        {
            _pendingInstallText = text;
            EndPreparation(genToken);
            StateHasChanged();
            await Scroll();
            return;
        }

        // Approche de la limite de tokens : l'historique ancien est condensé en un
        // résumé structuré par l'IA pour libérer de la place, en gardant les derniers
        // échanges bruts. Le modèle courant (et tout changement de modèle en cours de
        // conversation) garde ainsi accès à l'historique complet de la conversation.
        if (!genToken.IsCancellationRequested)
        {
            _loadingMessage = "Préparation de la conversation...";
            StateHasChanged();
            await Scroll();
        }
        var condensed = await Condenser.CondenseIfNeededAsync(_conversation, model, cancellationToken: genToken);
        if (condensed is not null)
        {
            _conversation = condensed;
            Toasts.ShowInfo("Mémoire",
                "La conversation a été condensée pour libérer des tokens (résumé + derniers échanges conservés).");
        }

        // Mémoire épisodique : rappel silencieux des échanges passés pertinents.
        string llmText = text;
        // Les messages triviaux (salutations, remerciements…) et les questions simples
        // ne bénéficient jamais d'un rappel épisodique utile et coûtent plusieurs
        // allers-retours d'embeddings avant le premier token (donc de la latence).
        var trivial = text.Trim().Length <= 50
            || _isLoading; // pas de mémoire si déjà en cours de chargement
        if (!genToken.IsCancellationRequested && !trivial)
        {
            _loadingMessage = "Rappel des souvenirs...";
            StateHasChanged();
            await Scroll();

            try
            {
                var episodic = await Episodes.RecallBlockAsync(text, genToken);
                if (!string.IsNullOrEmpty(episodic))
                    llmText = episodic + "\n\n" + text;
            }
            catch { /* le rappel ne doit jamais bloquer l'envoi */ }
        }

        if (genToken.IsCancellationRequested)
        {
            EndPreparation(genToken);
            return;
        }

        // Barge-in : si une génération est déjà en cours (elle réfléchit ou agit),
        // on lui laisse finir sa course sans l'annuler (l'ancienne garde sa propre
        // référence objet capturée). La nouvelle démarre sur un snapshot privé de
        // l'historique, qu'on re-assigne comme conversation courante : plus de
        // mutation partagée, pas d'écrasement — et le nouveau message enrichit l'IA.
        var conversation = _conversation;
        if (_isStreaming || _isLoading)
        {
            _chatEpoch++;
            conversation = _conversation.Clone();
            _conversation = conversation;
        }

        await StreamResponseAsync(llmText, model, text, conversation, precreatedToken: genToken);
        _preparing = false;
    }

    private bool ShouldProposeInstallAsync(string? model)
    {
        if (string.IsNullOrWhiteSpace(model)) return false;
        if (_manualOverride != null) return false;
        if (!_smartRoutingEnabled) return false;
        if (!_ollamaOnline) return false;
        if (_lastRoute?.DownloadSuggestion is not { } suggestion) return false;
        if (!IsSameModel(suggestion.Name, model)) return false;
        if (_pendingInstallModel is not null || _isInstallingModel) return false;

        var local = _localModels.Any(m => IsSameModel(m.Name, model));
        if (local) return false;

        var cloud = _cloudModels.Any(m => IsSameModel(m, model));
        if (cloud) return false;

        _pendingInstallModel = model;
        _pendingInstallSuggestion = suggestion;
        return true;
    }

    private static bool IsSameModel(string a, string b)
        => string.Equals(a.Trim(), b.Trim(), StringComparison.OrdinalIgnoreCase)
           || string.Equals(a.Trim().Split(':')[0], b.Trim().Split(':')[0], StringComparison.OrdinalIgnoreCase);

    private async Task StreamResponseAsync(string text, string? model = null, string? episodeQuestion = null, AIConversation? conversation = null, CancellationToken? precreatedToken = null)
    {
        var epoch = _chatEpoch;
        var sessionId = _sessionId;
        var conv = conversation ?? _conversation;
        if (conv is null) return;
        CancellationToken genToken;
        if (precreatedToken is { } pct)
            genToken = pct;
        else
        {
            Generation.Start();
            genToken = Generation.Token;
        }
        _activeEpoch = epoch;
        _isLoading = true;
        _isStreaming = true;
        _streamState = StreamState.Thinking;
        _loadingMessage = "";
        _toolActivities.Clear();
        _toolCallCount = 0;
        _genStopwatch.Restart();
        StateHasChanged();
        await ResizeInput();
        await Scroll();

        var full = "";
        var tokenCount = 0;
        var lastUiUpdate = System.Diagnostics.Stopwatch.StartNew();
        const int MinTokenInterval = 3; // Mettre à jour l'UI tous les 3 tokens minimum
        const int MaxMsBetweenUpdates = 80; // Ou toutes les 80ms max
        try
        {
            await foreach (var tok in AIService.StreamChatAsync(text, conv, model ?? _selectedModel, ModelSelectionMode.Powerful, genToken))
            {
                if (tok.Contains(IAIService.StreamRestartMarker))
                    full = tok.Replace(IAIService.StreamRestartMarker, string.Empty);
                else
                    full += tok;

                if (epoch != _chatEpoch)
                {
                    _isLoading = false;
                    _isStreaming = false;
                    continue;
                }
                if (_streamState == StreamState.Thinking)
                    _streamState = StreamState.Generating;
                if (_isStreaming)
                {
                    tokenCount++;
                    var shouldUpdate = tokenCount % MinTokenInterval == 0
                        || lastUiUpdate.ElapsedMilliseconds >= MaxMsBetweenUpdates;
                    if (shouldUpdate)
                    {
                        if (_messages.Count > 0 && !_messages.Last().IsUser)
                            _messages.RemoveAt(_messages.Count - 1);
                        _messages.Add(new ChatMessage(full, false, MdRenderer.RenderIncremental(full)));
                        StateHasChanged();
                        await Scroll();
                        lastUiUpdate.Restart();
                    }
                }
            }
            if (epoch == _chatEpoch)
            {
                if (!string.IsNullOrEmpty(full))
                {
                    if (_messages.Count > 0 && !_messages.Last().IsUser)
                        _messages.RemoveAt(_messages.Count - 1);
                    _messages.Add(new ChatMessage(full, false, MdRenderer.Render(full)));
                    AttachMetadata(_messages[^1]);
                    DrainPendingImages(_messages[^1]);
                    StateHasChanged();
                    await Scroll();
                    // Best-effort, borné dans le temps : l'affichage final ne doit pas
                    // dépendre du retour d'une interop engluée ni de l'overlay.
                    await JsSafeAsync("jarvis.highlightCode");
                    await JsSafeAsync("jarvis.renderMath");
                    try
                    {
                        using var so = new CancellationTokenSource(TimeSpan.FromSeconds(3));
                        await OverlayHubCtx.Clients.Group("desktop").SendAsync("overlayMessage", "Jarvis", full, so.Token);
                    }
                    catch { /* l'overlay est optionnel */ }
                    // Mémoire épisodique : l'échange devient un souvenir. Détaché du
                    // circuit (thread d'arrière-plan) pour ne jamais geler l'UI si le
                    // chemin mémoire (ex: OCR WinRT) venait à bloquer.
                    try { _ = Task.Run(() => Episodes.RecordAsync(episodeQuestion ?? text, full, "chat")); }
                    catch { /* la mémoire épisodique est optionnelle */ }
                }
                _streamState = StreamState.Completed;
            }
        }
        catch (OperationCanceledException)
        {
            if (epoch == _chatEpoch && !string.IsNullOrEmpty(full))
            {
                if (_messages.Count > 0 && !_messages.Last().IsUser)
                    _messages.RemoveAt(_messages.Count - 1);
                _messages.Add(new ChatMessage(full + " [stopped]", false, MdRenderer.Render(full + " [stopped]")));
                AttachMetadata(_messages[^1]);
                StateHasChanged();
                await Scroll();
            }
        }
        catch (Exception ex)
        {
            if (epoch == _chatEpoch)
            {
                var err = ex.InnerException?.Message ?? ex.Message;
                var modelInfo = string.IsNullOrEmpty(_selectedModel) ? "default" : _selectedModel;
                _messages.Add(new ChatMessage($"Error: {err}", false,
                    $"<p class=\"text-red-400\">⚠️ Error: {WebUtility.HtmlEncode(err)}</p>" +
                    $"<p class=\"text-xs text-muted mt-1\">Model: {WebUtility.HtmlEncode(modelInfo)} | Ollama endpoint: /api/chat</p>"));
                _ollamaOnline = false;
                DrainPendingImages(_messages[^1]);
                _streamState = StreamState.Failed;
                Toasts.ShowError("Erreur", "La réponse n'a pas pu être générée.");
            }
        }
        finally
        {
            if (!string.IsNullOrEmpty(full) && sessionId is not null)
            {
                Sessions.AppendMessage(sessionId, "assistant", full, _selectedModel ?? "");
                _ = Sessions.EnsureTitleAsync(sessionId);
                _ = Sessions.CheckRetitleAsync(sessionId);
                // Historique des tours : commit git + empreinte des fichiers modifiés
                // → rend ce tour annulable (« Revenir » / « Jarvis, annule tes changements »).
                var userRef = _messages.LastOrDefault(m => m.IsUser && m.TurnId is null);
                if (userRef is not null)
                {
                    // Détaché du circuit : ne doit jamais bloquer le rendu/l'UI.
                    try { _ = Task.Run(() => RecordTurnSafeAsync(userRef, text, full)); }
                    catch { /* l'historique des tours est optionnel */ }
                }
            }
            Generation.Complete(genToken);
            // Toujours remettre à l'état stable les indicateurs de frappe, même si
            // un autre turn a démarré entre-temps (sinon le pill « Jarvis écrit... »
            // reste bloqué après une réponse triviale). Le turn suivant re-situe son
            // propre état via son appel à StreamResponseAsync.
            AttachToolsToLastMessage();
            _isLoading = false; _isStreaming = false;
            _pendingGenImages.Clear();
            if (_streamState is StreamState.Thinking or StreamState.Generating or StreamState.ToolExecution)
                _streamState = StreamState.Completed;
            // Flush synchrone de l'état stable AVANT toute interop : le pill doit se
            // dégager même si le WebView2 n'acquitte jamais le scroll.
            StateHasChanged();
            _ = Scroll();
        }
    }

    private void AttachMetadata(ChatMessage msg)
    {
        _genStopwatch.Stop();
        var run = RunMonitor.Last;
        msg.Model = _selectedModel;
        msg.DurationMs = _genStopwatch.Elapsed.TotalMilliseconds;
        msg.TokenCount = run?.CompletionTokens;
        msg.ToolCallCount = _toolCallCount;
        msg.AgentDurationMs = _activeRecord?.CompletedAt.HasValue == true ? _activeRecord.TotalDurationMs : null;
    }

    private void EnsureSession()
    {
        if (_sessionId is not null) return;
        _sessionId = Sessions.CreateSession("chat").Id;
        try { Nav.NavigateTo($"/chat/{_sessionId}", replace: true); } catch { }
    }

    private void LoadSessionIntoUi(ConversationSession session)
    {
        _messages.Clear();
        _cancelledMessages.Clear();
        _cancelledExpanded = false;
        _activeRecord = null;
        _conversation = new AIConversation(AgentSystemPrompt.Build(ToolDefinitionBuilder.Build(ToolRegistry)));
        foreach (var m in session.Messages)
        {
            var isUser = string.Equals(m.Role, "user", StringComparison.OrdinalIgnoreCase);
            _messages.Add(new ChatMessage(m.Text, isUser, MdRenderer.Render(m.Text)));
            if (isUser) _conversation.AddUserMessage(m.Text);
            else _conversation.AddAssistantMessage(m.Text);
        }
        if (!string.IsNullOrWhiteSpace(session.Model))
            _selectedModel = session.Model;
    }

    private async Task Regenerate()
    {
        if (_isLoading || _isStreaming || _conversation is null) return;
        var lastUserText = _conversation.LastUserText();
        if (string.IsNullOrWhiteSpace(lastUserText)) return;

        var userIndex = _conversation.IndexOfLastUserMessage();
        _conversation.RemoveFrom(userIndex);

        var uiUserIndex = FindLastUserIndex();
        if (uiUserIndex >= 0 && _messages.Count > uiUserIndex + 1)
            _messages.RemoveRange(uiUserIndex + 1, _messages.Count - uiUserIndex - 1);

        if (_sessionId is not null)
            Sessions.TruncateAfterLastUser(_sessionId);

        await StreamResponseAsync(lastUserText, await ResolveModelAsync(lastUserText));
    }

    private async Task Resume()
    {
        if (_isLoading || _isStreaming || _conversation is null) return;
        var lastUserText = _conversation.LastUserText();
        if (string.IsNullOrWhiteSpace(lastUserText)) return;

        var partial = _messages.LastOrDefault(m => !m.IsUser)?.Text ?? "";
        partial = partial.Replace(" [stopped]", "");

        _conversation.RemoveFrom(_conversation.IndexOfLastUserMessage());
        if (!string.IsNullOrWhiteSpace(partial))
        {
            _conversation.AddMessage(AIMessage.System(
                $"The assistant's previous response was interrupted after this text: \"{partial}\". " +
                "Continue exactly from where it stopped without repeating the text above."));
        }

        var lastAssistant = _messages.LastOrDefault(m => !m.IsUser);
        if (lastAssistant is not null)
            _messages.Remove(lastAssistant);

        if (_sessionId is not null)
            Sessions.TruncateAfterLastUser(_sessionId);

        await StreamResponseAsync(lastUserText, await ResolveModelAsync(lastUserText));
    }

    private void EditLastMessage(ChatMessage msg)
    {
        if (_isLoading || _isStreaming) return;
        _editingMessage = msg;
        _editText = msg.Text;
    }

    private void CancelEdit() => _editingMessage = null;

    private async Task SaveEdit()
    {
        if (_editingMessage is null || _conversation is null) return;
        var editedText = _editText.Trim();
        if (string.IsNullOrWhiteSpace(editedText))
        {
            _editingMessage = null;
            return;
        }

        _conversation.ReplaceLastUserMessage(editedText);
        var userIndex = _conversation.IndexOfLastUserMessage();
        _conversation.RemoveFrom(userIndex + 1);

        _editingMessage.Text = editedText;
        _editingMessage.HtmlContent = MdRenderer.Render(editedText);
        var uiUserIndex = _messages.IndexOf(_editingMessage);
        if (uiUserIndex >= 0 && _messages.Count > uiUserIndex + 1)
            _messages.RemoveRange(uiUserIndex + 1, _messages.Count - uiUserIndex - 1);

        _editingMessage = null;
        if (_sessionId is not null)
        {
            Sessions.ReplaceLastUserMessage(_sessionId, editedText);
            Sessions.TruncateAfterLastUser(_sessionId);
        }
        await StreamResponseAsync(editedText, await ResolveModelAsync(editedText));
    }

    private async Task RecordTurnSafeAsync(ChatMessage userMsg, string ask, string answer)
    {
        try
        {
            var record = await Turns.RecordAsync("chat", ask, answer);
            if (record is not null && userMsg.TurnId is null)
                await InvokeAsync(() => { userMsg.TurnId = record.Id; StateHasChanged(); });
        }
        catch { /* l'historique des tours est optionnel */ }
    }

    /// <summary>
    /// Retour arrière conversationnel : annule les tours à partir de ce message
    /// (fichiers inclus via l'historique git), tronque conversation et session,
    /// et préremplit éventuellement la zone de saisie pour modifier la demande.
    /// </summary>
    private async Task RewindTo(ChatMessage msg, bool prefillForEdit)
    {
        if (_isLoading || _isStreaming || _rewinding || _conversation is null) return;
        var index = _messages.IndexOf(msg);
        if (index < 0 || !msg.IsUser) return;
        _rewinding = true;
        try
        {
            // 1) Rollback des fichiers + historique des tours
            string fileSummary = !string.IsNullOrEmpty(msg.TurnId)
                ? await Turns.RewindBeforeAsync(msg.TurnId!)
                : "tour antérieur à l'historique des fichiers — conversation seule.";

            // 2) Troncature de la conversation LLM à ce tour
            var ordinal = _messages.Take(index).Count(m => m.IsUser);
            int seen = 0, convIndex = -1;
            for (var i = 0; i < _conversation.Messages.Count; i++)
            {
                if (_conversation.Messages[i].Role == AIMessageRole.User)
                {
                    if (seen == ordinal) { convIndex = i; break; }
                    seen++;
                }
            }
            if (convIndex >= 0) _conversation.RemoveFrom(convIndex);

            // 3) Troncature de l'UI et du store de sessions
            var removedUi = _messages.Count - index;

            // Récupère les messages « annulés » avant de les retirer, pour les
            // afficher dans la bannière « X messages annulés » et permettre de
            // les restaurer. On garde uniquement le texte (la demande de l'user).
            var removed = _messages.GetRange(index, removedUi).Where(m => m.IsUser && !string.IsNullOrWhiteSpace(m.Text)).ToList();
            foreach (var m in removed)
            {
                _cancelledMessages.Insert(0, new CancelledMessage(m.Text, true));
            }
            _cancelledExpanded = false;

            _messages.RemoveRange(index, removedUi);
            if (_sessionId is not null) Sessions.TruncateFromEnd(_sessionId, removedUi);

            _editingMessage = null;
            if (prefillForEdit) _input = msg.Text;

            Toasts.ShowInfo("Retour arrière",
                fileSummary.Length > 180 ? fileSummary[..180] + "…" : fileSummary);
            StateHasChanged();
            await Scroll();
        }
        catch (Exception ex)
        {
            Toasts.ShowError("Retour arrière", ex.Message);
        }
        finally
        {
            _rewinding = false;
        }
    }

    /// <summary>Restaure un message annulé : le remet dans la zone de saisie
    /// pour pouvoir le réenvoyer ou le modifier.</summary>
    private void RestoreCancelled(CancelledMessage cm)
    {
        if (cm is null) return;
        if (cm.IsUser)
        {
            _input = cm.Text;
            _ = JsSafeAsync("jarvis.focusInput", "chat-input");
        }
        _cancelledMessages.Remove(cm);
        StateHasChanged();
    }

    private int FindLastUserIndex()
    {
        for (var i = _messages.Count - 1; i >= 0; i--)
        {
            if (_messages[i].IsUser) return i;
        }
        return -1;
    }

    private void Cancel()
    {
        Generation.Cancel();
        // Pendant la phase de préparation (hors streaming), le token annulé fait
        // sortir proprement SendCoreAsync : on remet l'interface au repos ici.
        if (_preparing)
            EndPreparation(Generation.Token);
    }

    // Termine proprement une préparation interrompue (annulée ou abandonnée) en
    // ramenant l'interface à l'état repos, hors du flux de streaming. Complete est
    // scopé au token : un token obsolète (nouvelle génération démarrée entre-temps)
    // n'est jamais disposé ici.
    private void EndPreparation(CancellationToken genToken)
    {
        _preparing = false;
        _isLoading = false;
        _isStreaming = false;
        _streamState = StreamState.Idle;
        _loadingMessage = "";
        Generation.Complete(genToken);
        StateHasChanged();
        _ = Scroll();
    }

    private async Task KeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Send();
        }
        else if (e.Key == "ArrowUp")
        {
            if (_historyIndex == -1 && !string.IsNullOrWhiteSpace(_input))
                return;
            await NavigateHistory(-1);
        }
        else if (e.Key == "ArrowDown" && _historyIndex != -1)
        {
            await NavigateHistory(1);
        }
    }

    private async Task NavigateHistory(int direction)
    {
        if (_sentHistory.Count == 0) return;

        var newIndex = _historyIndex + direction;
        if (newIndex < 0) return;

        if (newIndex >= _sentHistory.Count)
        {
            _historyIndex = -1;
            _input = "";
        }
        else
        {
            _historyIndex = newIndex;
            _input = _sentHistory[_historyIndex];
        }

        StateHasChanged();
        await ResizeInput();
    }

