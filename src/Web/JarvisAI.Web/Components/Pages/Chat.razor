            <div class="flex items-center justify-between px-4 py-3 border-b border-border">
                <div class="text-sm font-medium text-primary">Générer une image</div>
                <button class="w-7 h-7 rounded-lg hover:bg-mainbg transition-colors flex items-center justify-center text-muted hover:text-primary bg-transparent border-0 cursor-pointer text-sm" @onclick="CloseImageGenModal" title="Fermer">✕</button>
            </div>
            <div class="px-4 py-3 border-b border-border space-y-2">
                <input @bind="_imageGenPrompt" @bind:event="oninput" placeholder="Décris l'image à générer (ex: un chat en costume dans l'espace)..." class="w-full bg-mainbg border border-border rounded-lg px-3 py-2 text-xs text-primary outline-none placeholder:text-muted focus:border-accent" @onkeydown="HandleImageGenKeyDown" />
                <button class="w-full px-3 py-2 text-xs font-medium rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors disabled:opacity-30 border-0 cursor-pointer" @onclick="GenerateImage" disabled="@(_imageGenLoading || string.IsNullOrWhiteSpace(_imageGenPrompt))">
