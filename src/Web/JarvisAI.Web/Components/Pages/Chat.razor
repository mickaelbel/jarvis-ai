    // Interop JS « best-effort » bornée dans le temps. UI = Blazor Server sur
    // SignalR : un appel JS jamais acquitté (WebView2 englué) bloquerait le circuit
    // pour toujours → clics figés + pill « Jarvis écrit... » éternel. On borne chaque
    // appel et on traite un timeout comme non fatal pour que le circuit reprenne.
    private async Task JsSafeAsync(string identifier, params object?[] args)
    {
        try
        {
            var inv = Js.InvokeVoidAsync(identifier, args).AsTask();
            var done = await Task.WhenAny(inv, Task.Delay(TimeSpan.FromSeconds(3)));
            if (done != inv)
            {
                // l'invocation reste pendue : on la laisse partir sans l'attendre.
                _ = inv.ContinueWith(t => _ = t.Exception,
                    TaskContinuationOptions.OnlyOnFaulted | TaskContinuationOptions.ExecuteSynchronously);
            }
            else if (inv.IsFaulted)
            {
                _ = inv.Exception;
            }
        }
        catch { /* interop indisponible / timeout : jamais bloquant */ }
    }

