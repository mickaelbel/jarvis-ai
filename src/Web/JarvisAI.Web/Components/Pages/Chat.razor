    private async Task RunAutonomousAsync(string goal, string displayText)
    {
        _messages.Add(new ChatMessage(displayText, true, MdRenderer.Render(displayText)));

        EnsureSession();
        var sessionId = _sessionId;
        Sessions.AppendMessage(sessionId!, "user", displayText, _selectedModel ?? "");

        var epoch = _chatEpoch;
        Generation.Start();
        var genToken = Generation.Token;
        _activeEpoch = epoch;
        _isLoading = true;
        _isStreaming = true;
        _streamState = StreamState.ToolExecution;
        _toolActivities.Clear();
        _toolCallCount = 0;
        StateHasChanged();
        await Scroll();

        try
        {
            // Mode multi-agent : l'objectif peut être décomposé en sous-tâches
            // INDÉPENDANTES, chacune exécutée en PARALLÈLE sur son propre agent et
            // son propre onglet navigateur, puis synthétisées en une réponse finale.
            try
            {
                // Le SUPERVISEUR central orchestre : perception, agent spécialisé,
                // plan/tâches, exécution (simple ou multi-agents parallèles), puis
                // vérification et replanification. C'est le point d'entrée unique
                // de l'agent autonome.
                var supervised = await Supervisor.ExecuteAsync(new AgentRequest
                {
                    Goal = goal,
                    Mode = ModelSelectionMode.Powerful,
                    Source = "chat",
                    AllowParallelTools = true,
                    CorrelationId = Guid.NewGuid()
                }, genToken);
                var response = supervised.Success
                    ? supervised.FinalResponse
                    : $"Could not complete autonomously ({supervised.CompletedTasks}/{supervised.TaskCount} tâches) : {supervised.Reason ?? supervised.Correction}";
                if (string.IsNullOrWhiteSpace(response))
                    response = "No response from the autonomous loop.";
                if (!supervised.Verified && supervised.Success)
                    response = $"✅ {response}";
                if (epoch == _chatEpoch)
                    _messages.Add(new ChatMessage(response, false, MdRenderer.Render(response)));
                if (sessionId is not null)
                    Sessions.AppendMessage(sessionId, "assistant", response, _selectedModel ?? "");
                if (epoch == _chatEpoch)
                {
                    AttachToolsToLastMessage();
                    _streamState = StreamState.Completed;
                }
            }
            catch (OperationCanceledException) { throw; }
            catch (Exception ex)
            {
                // Repli 1 : multi-agent (décomposition parallèle) si le superviseur échoue.
                try
                {
                    var multi = await MultiAgent.ExecuteAsync(goal, ModelSelectionMode.Powerful, genToken);
                    var response = multi.Success
                        ? multi.FinalResponse
                        : $"Could not complete autonomously ({multi.SubAgents} sous-agent(s)): {multi.Reason}";
                    if (string.IsNullOrWhiteSpace(response))
                        response = ex.Message;
                    if (multi.SubAgents > 1)
                        response = $"🧩 Multi-agent : {multi.SubAgents} recherches en parallèle\n\n{response}";
                    if (epoch == _chatEpoch)
                        _messages.Add(new ChatMessage(response, false, MdRenderer.Render(response)));
                    if (sessionId is not null)
                        Sessions.AppendMessage(sessionId, "assistant", response, _selectedModel ?? "");
                    if (epoch == _chatEpoch)
                    {
                        AttachToolsToLastMessage();
                        _streamState = StreamState.Completed;
                    }
                }
                catch
                {
                    // Repli 2 : orchestrateur agent unique.
                    var request = new AgentRequest
                    {
                        Goal = goal,
                        Mode = ModelSelectionMode.Powerful,
                        Source = "chat",
                        AllowParallelTools = true
                    };
                    var result = await Orchestrator.ExecuteAsync(request, genToken);
                    var resp = result.Success
                        ? result.FinalResponse
                        : $"Could not complete autonomously ({result.Iterations} iterations, {result.Corrections} corrections): {result.Reason}";
                    if (string.IsNullOrWhiteSpace(resp))
                        resp = "No response from the autonomous loop.";
                    if (epoch == _chatEpoch)
                        _messages.Add(new ChatMessage(resp, false, MdRenderer.Render(resp)));
                    if (sessionId is not null)
                        Sessions.AppendMessage(sessionId, "assistant", resp, _selectedModel ?? "");
                    if (epoch == _chatEpoch)
                    {
                        AttachToolsToLastMessage();
                        _streamState = StreamState.Completed;
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (epoch == _chatEpoch)
            {
                _messages.Add(new ChatMessage("[autonomous run stopped]", false));
                _streamState = StreamState.Completed;
            }
        }
        catch (Exception ex)
        {
            var err = ex.InnerException?.Message ?? ex.Message;
            if (epoch == _chatEpoch)
            {
                _messages.Add(new ChatMessage($"Autonomous error: {err}", false, $"<p class=\"text-red-400\">⚠️ {WebUtility.HtmlEncode(err)}</p>"));
                _streamState = StreamState.Failed;
                Toasts.ShowError("Erreur", "L'exécution autonome a échoué.");
            }
        }
        finally
        {
            if (sessionId is not null)
            {
                _ = Sessions.EnsureTitleAsync(sessionId);
                _ = Sessions.CheckRetitleAsync(sessionId);
            }
            Generation.Complete(genToken);
            if (epoch == _chatEpoch)
            {
                _isLoading = false; _isStreaming = false;
                StateHasChanged();
                await Scroll();
            }
        }
    }

    private async Task HandleFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(4))
        {
            if (file.Size > 8 * 1024 * 1024) continue;
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
                _uploadedImages.Add(new UploadedImage(file.Name, dataUrl, bytes));
            }
            catch { }
        }
        StateHasChanged();
    }

