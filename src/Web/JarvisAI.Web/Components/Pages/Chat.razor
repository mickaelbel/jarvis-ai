                else if (!string.IsNullOrEmpty(_imageGenResult))
                {
                    <img src="@_imageGenResult" class="w-full rounded-xl border border-border object-contain" alt="Image générée" />
                    <div class="mt-3 flex items-center gap-2">
                        <button class="flex-1 text-xs px-3 py-2 rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors border-0 cursor-pointer" @onclick="DownloadGeneratedImage" title="Télécharger l'image">
                            Télécharger l'image
                        </button>
                        <button class="flex-1 text-xs px-3 py-2 rounded-lg bg-surface text-primary hover:bg-mainbg transition-colors border border-border cursor-pointer" @onclick="SendGeneratedImage" title="Envoyer l'image dans le chat">
