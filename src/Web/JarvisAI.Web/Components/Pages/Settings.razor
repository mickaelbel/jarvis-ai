    // Intégrations
    private JarvisAI.Infrastructure.Integrations.IntegrationsSettings? _integ;
    private string _icalUrlsText = "";
    private bool _savingIntegrations;
    private string _integrationsInfo = "";
    private string? _testingIntegration;
    private string? _testedIntegration;
    private bool _integrationTestOk;
    private string _integrationTestInfo = "";

    // Profils
    private List<string> _profiles = new();
    private string _selectedProfile = "default";
    private string _profileStatus = "";

    private async Task TestIntegration(string key)
    {
        _testingIntegration = key;
        _integrationTestInfo = "Test en cours…";
        StateHasChanged();
        try
        {
            var res = await Http.PostAsync($"/api/integrations/test/{key}", null);
            var json = await res.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var ok = doc.RootElement.GetProperty("success").GetBoolean();
            var output = doc.RootElement.TryGetProperty("output", out var o) ? o.GetString() : "";
            var note = doc.RootElement.TryGetProperty("note", out var n) ? n.GetString() : "";
            _integrationTestOk = ok;
            _testedIntegration = key;
            _integrationTestInfo = ok
                ? $"{key} : OK ({note}) — {TruncateInfo(output ?? "")}"
                : $"{key} : échec — {TruncateInfo(output ?? "")}";
        }
        catch (Exception ex)
        {
            _integrationTestOk = false;
            _integrationTestInfo = $"Erreur : {ex.Message}";
        }
        finally
        {
            _testingIntegration = null;
            StateHasChanged();
        }
    }

    private static string TruncateInfo(string s) => s.Length <= 160 ? s.Replace("\n", " ") : s[..157].Replace("\n", " ") + "…";

    private JarvisAI.Infrastructure.Integrations.InstagramAccount IntegAccount1()
    {
        if (_integ!.Instagram.Comptes.Count == 0) _integ.Instagram.Comptes.Add(new());
        return _integ.Instagram.Comptes[0];
    }
    private JarvisAI.Infrastructure.Integrations.InstagramAccount IntegAccount2()
    {
        while (_integ!.Instagram.Comptes.Count < 2) _integ.Instagram.Comptes.Add(new());
        return _integ.Instagram.Comptes[1];
    }

    private async Task LoadIntegrations()
    {
        try
        {
            var res = await Http.GetAsync("/api/integrations");
            res.EnsureSuccessStatusCode();
            var json = await res.Content.ReadAsStringAsync();
            _integ = JsonSerializer.Deserialize<JarvisAI.Infrastructure.Integrations.IntegrationsSettings>(json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            _icalUrlsText = string.Join("\n", _integ.Google.IcalUrls);
        }
        catch (Exception ex)
        {
            _integrationsInfo = $"Erreur : {ex.Message}";
            _integ = new();
        }
    }

    private async Task SaveIntegrations()
    {
        if (_integ is null) return;
        _savingIntegrations = true;
        try
        {
            _integ.Google.IcalUrls = _icalUrlsText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            var json = JsonSerializer.Serialize(_integ, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
            var res = await Http.PostAsync("/api/integrations", new StringContent(json, Encoding.UTF8, "application/json"));
            _integrationsInfo = res.IsSuccessStatusCode ? "Identifiants enregistrés — utilisables immédiatement." : $"Erreur : {(int)res.StatusCode}";
        }
        catch (Exception ex)
        {
            _integrationsInfo = $"Erreur : {ex.Message}";
        }
        finally
        {
            _savingIntegrations = false;
            StateHasChanged();
        }
    }
    private bool _showAddPanel;
    private bool _providersSaving;
    private string _providersStatus = "";
    private string _providerTestingKey = "";
    private Dictionary<string, SmartRouteDto?> _providerResults = new();
    private bool _voiceTesting;
    private SmartRouteDto? _voiceTestResult;

    private sealed class ProviderViewModel
    {
        public string Key { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Description { get; set; } = "";
        public bool RequiresKey { get; set; }
        public bool Enabled { get; set; } = true;
        public bool Added { get; set; }
        public string ApiKey { get; set; } = "";
        public string BaseUrl { get; set; } = "";
        public string DefaultModel { get; set; } = "";
        public string ChatPath { get; set; } = "";
        public IReadOnlyList<string> Models { get; set; } = Array.Empty<string>();
        public IReadOnlyList<string> Prefixes { get; set; } = Array.Empty<string>();
        public IReadOnlyList<string> CustomModels { get; set; } = Array.Empty<string>();

        public List<string> AllModels =>
            Models.Concat(CustomModels).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<string> ProviderModels(ProviderViewModel p) => p.AllModels;

    private sealed record AvailableModel(string Name, string Source, string Label, bool Installed, string Size);
    private sealed record ModelGroup(string Label, List<AvailableModel> Models);

    private List<ModelGroup> _availableModelGroups
    {
        get
        {
            var groups = new List<ModelGroup>();
            var cloudByProvider = _availableModels
                .Where(m => m.Source == "cloud")
                .GroupBy(m => m.Label)
                .OrderBy(g => g.Key);
            foreach (var g in cloudByProvider)
                groups.Add(new ModelGroup(g.Key, g.ToList()));
            var catalog = _availableModels.Where(m => m.Source == "catalog").ToList();
            if (catalog.Count > 0) groups.Add(new ModelGroup("Ollama (gratuit)", catalog));
            return groups;
        }
    }

    private sealed record SmartRouteDto(
        string Model,
        string Profile,
        string Reason,
        bool MultiStep,
        bool Success,
        string? Error,
        string? Response,
        long ElapsedMs,
        CatalogDto? DownloadSuggestion);
    private sealed record CatalogDto(string Name, string Description, string Parameters, string DownloadSize);

    private sealed class VoiceSettingsModel
    {
        public bool VoiceEnabled { get; set; } = true;
        public bool WakeWordEnabled { get; set; } = true;
        public bool BargeInEnabled { get; set; } = true;
        public bool PassiveMode { get; set; }
        public string MicDeviceId { get; set; } = "";
        public string SpeakerDeviceId { get; set; } = "";
        public string TtsVoice { get; set; } = "fr_FR-upmc-medium";
        public float Volume { get; set; } = 1.0f;
        public string Model { get; set; } = "";
        public bool AudioDuckingEnabled { get; set; }
        public float AudioDuckingSystemVolume { get; set; } = 0.3f;
        public float AudioDuckingMusicVolume { get; set; } = 0.1f;
        public int AudioDuckingFadeMs { get; set; } = 1500;
        public string AudioDuckingExcludedApps { get; set; } = "";
        public string AudioDuckingShortcut { get; set; } = "Ctrl+Shift+D";
    }

    private sealed record DeviceInfo(string Id, string Label);

    private sealed class DebugModeModel
    {
        public bool Enabled { get; set; }
        public bool Unlocked { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Http.BaseAddress = new Uri(Nav.BaseUri);
        await LoadVoiceSettingsAsync();
        await LoadDevicesAsync();
        await LoadVoicesAsync();
        await LoadAvailableModelsAsync();
        await LoadProvidersAsync();
        await LoadSecurityOptionsAsync();
        await LoadDebugStateAsync();
        await LoadModelsPathAsync();
        _smart = SmartRouting.Get();
        LoadProfiles();
        await LoadAccentAsync();
    }

    private async Task LoadAccentAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string>("jarvis.getPref", "accentColor");
            if (!string.IsNullOrWhiteSpace(saved))
                _accentColor = saved;
            else
                await JS.InvokeVoidAsync("jarvis.initAccent");
        }
        catch { }
    }

    private async Task SelectAccent(string value)
    {
        _accentColor = value;
        await ApplyAccentAsync();
    }

    private async Task OnCustomAccent(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val))
        {
            _accentColor = val;
            await ApplyAccentAsync();
        }
    }

    private async Task ApplyAccentAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("jarvis.applyAccent", _accentColor);
            await JS.InvokeVoidAsync("jarvis.setPref", "accentColor", _accentColor);
        }
        catch { }
    }

    private async Task LoadModelsPathAsync()
    {
        try
        {
            var res = await Http.GetAsync("/api/ollama/models-path");
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                _modelsPath = doc.RootElement.TryGetProperty("path", out var p) ? p.GetString() ?? "" : "";
                _modelsPathInfo = doc.RootElement.TryGetProperty("exists", out var e) && e.GetBoolean()
                    ? $"Dossier actif : {_modelsPath}"
                    : $"Dossier actif : {_modelsPath} (n'existe pas encore, il sera créé)";
            }
        }
        catch { }
    }

    private async Task SaveModelsPath()
    {
        _savingModelsPath = true;
        _modelsPathInfo = "";
        try
        {
            var json = JsonSerializer.Serialize(new { path = _modelsPath });
            var res = await Http.PostAsync("/api/ollama/models-path",
                new StringContent(json, Encoding.UTF8, "application/json"));
            var text = await res.Content.ReadAsStringAsync();
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(text);
                _modelsPath = doc.RootElement.TryGetProperty("path", out var p) ? p.GetString() ?? _modelsPath : _modelsPath;
                _modelsPathInfo = doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() ?? "Dossier enregistré." : "Dossier enregistré.";
            }
            else
            {
                _modelsPathInfo = $"Erreur : {text}";
            }
        }
        catch (Exception ex)
        {
            _modelsPathInfo = $"Erreur : {ex.Message}";
        }
        finally
        {
            _savingModelsPath = false;
        }
    }

    private async Task LoadSecurityOptionsAsync()
    {
        try
        {
