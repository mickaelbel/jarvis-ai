    private static float ParseFloat(string s) =>
        float.TryParse(s, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0f;

    private static float ParseSliderFloat(string? s, float fallback) =>
        float.TryParse(s, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private static int ParseSliderInt(string? s, int fallback) =>
        int.TryParse(s, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : fallback;

    // --- Profils ---
    private void LoadProfiles()
    {
        _profiles = Profiles.ListProfiles().ToList();
        _selectedProfile = Profiles.ActiveProfile;
    }

    private async Task LoadProfile()
    {
        var json = Profiles.LoadProfile(_selectedProfile);
        if (json is null) { _profileStatus = "Profil introuvable."; return; }
        Profiles.SetActive(_selectedProfile);
        _profileStatus = $"Profil '{_selectedProfile}' chargé.";
        StateHasChanged();
    }

    private async Task SaveAsProfile()
    {
        var name = await JS.InvokeAsync<string>("prompt", "Nom du nouveau profil :", "");
        if (string.IsNullOrWhiteSpace(name)) return;
        var json = System.Text.Json.JsonSerializer.Serialize(_settings, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        Profiles.SaveProfile(name, json);
        Profiles.SetActive(name);
        LoadProfiles();
        _selectedProfile = name;
        _profileStatus = $"Profil '{name}' sauvegardé.";
    }

    private async Task DeleteProfile()
    {
        if (_selectedProfile == "default") return;
        Profiles.DeleteProfile(_selectedProfile);
        LoadProfiles();
        _selectedProfile = "default";
        _profileStatus = "Profil supprimé.";
    }

    private async Task ExportConfig()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(_settings, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:application/json;base64,{base64}';a.download='jarvis-settings.json';a.click();");
        _profileStatus = "Configuration exportée.";
    }

    private async Task ImportConfig()
    {
        var json = await JS.InvokeAsync<string>("prompt", "Collez le JSON de configuration :", "");
        if (string.IsNullOrWhiteSpace(json)) return;
        try
        {
            var imported = System.Text.Json.JsonSerializer.Deserialize<VoiceSettingsModel>(json);
            if (imported is not null)
            {
                _settings = imported;
                _profileStatus = "Configuration importée. Cliquez sur Enregistrer pour appliquer.";
            }
        }
        catch { _profileStatus = "JSON invalide."; }
    }

    // Noms d'affichage友好的 pour les voix
    private static string GetVoiceDisplayName(string voiceId) => voiceId switch
    {
        // Edge TTS — voix françaises
        "fr-FR-HenriNeural" => "Henri (Masculin — JARVIS-like)",
        "fr-FR-DeniseNeural" => "Denise (Féminin)",
        "fr-FR-EloiseNeural" => "Eloise (Féminin jeune)",
        "fr-FR-JacquesNeural" => "Jacques (Masculin grave)",
        "fr-FR-YvetteNeural" => "Yvette (Féminin mature)",
        // Piper — voix françaises
        "fr_FR-upmc-medium" => "Piper Henri (Local, moyen)",
        "fr_FR-siwis-low" => "Piper Siwis (Local, douce)",
        "fr_FR-tom-medium" => "Piper Tom (Local, moyen)",
        // Fallback : nettoyer l'ID
        _ => voiceId.Replace("fr_FR-", "Piper ").Replace("fr-FR-", "").Replace("Neural", "").Replace("-", " ").Trim()
    };
