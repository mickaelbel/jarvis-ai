@page "/settings"
@rendermode InteractiveServer
@using System.Text
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject ILogger<Settings> Logger

<div class="max-w-4xl mx-auto px-4 md:px-6 py-6">

    @* ── Search bar ── *@
    <div class="settings-search jarvis-glass mb-6">
        <svg class="settings-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" @bind="_searchQuery" @bind:after="OnSearchChanged"
               placeholder="Rechercher dans les parametres..." />
    </div>

    @* ── Category tabs ── *@
    <div class="settings-tabs jarvis-glass mb-4">
        <button class="settings-tab @(_activeTab == "voice" ? "active" : "")" @onclick='() => SetTab("voice")'>Voix</button>
        <button class="settings-tab @(_activeTab == "ai" ? "active" : "")" @onclick='() => SetTab("ai")'>IA</button>
        <button class="settings-tab @(_activeTab == "appearance" ? "active" : "")" @onclick='() => SetTab("appearance")'>Theme</button>
        <button class="settings-tab @(_activeTab == "integrations" ? "active" : "")" @onclick='() => SetTab("integrations")'>Integ.</button>
        <button class="settings-tab @(_activeTab == "system" ? "active" : "")" @onclick='() => SetTab("system")'>Systeme</button>
        <button class="settings-tab @(_activeTab == "advanced" ? "active" : "")" @onclick='() => SetTab("advanced")'>Avance</button>
    </div>

    @if (_searchResults.Count > 0 && !string.IsNullOrWhiteSpace(_searchQuery))
    {
        @* ── Search results mode ── *@
        <div class="space-y-3">
            <div class="text-xs text-muted mb-2">@_searchResults.Count resultat(s) pour "@_searchQuery"</div>
            @foreach (var result in _searchResults)
            {
                <div class="settings-card settings-search-match cursor-pointer" @onclick="() => JumpToResult(result)">
                    <div class="flex items-center gap-3">
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-accent/10 text-accent font-medium uppercase tracking-wide">@result.Category</span>
                        <span class="settings-card-title">@result.Label</span>
                    </div>
                    <div class="settings-card-desc mt-1">@result.Description</div>
                </div>
            }
        </div>
    }
    else
    {
        @* ── Voice & Audio ── *@
        @if (_activeTab == "voice")
        {
            <div class="space-y-3 mb-6" data-search-group="voice">
                <div class="settings-card-label">Peripheriques audio</div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div class="settings-card">
                        <div class="settings-card-desc mb-2">Microphone</div>
                        <select class="settings-select" @onchange="OnMicChanged">
                            @foreach (var mic in _mics)
                            {
                                <option value="@mic.Id" selected="@(mic.Id == _settings.MicDeviceId)">@mic.Label</option>
                            }
                        </select>
                    </div>
                    <div class="settings-card">
                        <div class="settings-card-desc mb-2">Haut-parleur</div>
                        <select class="settings-select" @onchange="OnSpeakerChanged">
                            @foreach (var spk in _speakers)
                            {
                                <option value="@spk.Id" selected="@(spk.Id == _settings.SpeakerDeviceId)">@spk.Label</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="settings-card-desc mb-2">Voix (TTS)</div>
                    <div class="flex gap-2">
                        <select class="settings-select flex-1" @onchange="OnVoiceChanged">
                            @foreach (var group in GetVoiceGroups())
                            {
                                <optgroup label="@(group.Label)">
                                    @foreach (var v in group.Voices)
                                    {
                                        <option value="@v.Id" selected="@(v.Id == _settings.TtsVoice)">@GetVoiceDisplayName(v.Id)</option>
                                    }
                                </optgroup>
                            }
                            @if (_voiceList.Count == 0)
                            {
                                <option value="" disabled>Aucune voix detectee</option>
                            }
                        </select>
                        <button class="settings-btn-secondary" @onclick="OnTestTts">Tester</button>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="settings-card-desc mb-2">Modele IA (voix)</div>
                    <div class="flex gap-2">
                        <select class="settings-select flex-1" @bind="_settings.Model" @bind:after="OnVoiceModelChanged">
                            <option value="">Auto (defaut)</option>
                            @foreach (var group in _availableModelGroups)
                            {
                                <optgroup label="@group.Label">
                                    @foreach (var m in group.Models)
                                    {
                                        <option value="@m.Name">@m.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <button class="settings-btn-secondary" @onclick="TestVoiceModel" disabled="@_voiceTesting">@(_voiceTesting ? "..." : "Tester")</button>
                    </div>
                    @if (_voiceTestResult is not null)
                    {
                        <div class="text-[11px] mt-1">@(_voiceTestResult.Success ? $"OK {_voiceTestResult.Model}" : $"Erreur {_voiceTestResult.Error}")</div>
                    }
                </div>

                <div class="settings-card">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <div class="settings-card-title">Volume</div>
                            <div class="settings-card-desc">@((int)(_settings.Volume * 100))%</div>
                        </div>
                    </div>
                    <input type="range" min="0" max="100" value="@((int)(_settings.Volume * 100))" class="settings-range" @oninput="OnVolumeChanged" />
                </div>

                <div class="settings-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="settings-card-title">Baisse de volume auto</div>
                            <div class="settings-card-desc">Baisse le volume des autres apps quand Jarvis parle</div>
                        </div>
                        <label class="settings-toggle">
                            <input type="checkbox" class="sr-only peer" @bind="_settings.AudioDuckingEnabled" />
                            <div class="settings-toggle-track"></div>
                        </label>
                    </div>
                    @if (_settings.AudioDuckingEnabled)
                    {
                        <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div class="flex items-center justify-between">
                                <span class="settings-card-desc">Volume systeme</span>
                                <div class="flex items-center gap-2">
                                    <input type="range" min="0" max="100" value="@((int)(_settings.AudioDuckingSystemVolume * 100))" class="settings-range w-24" @oninput="e => _settings.AudioDuckingSystemVolume = ParseSliderFloat(e.Value?.ToString(), 30f) / 100" />
                                    <span class="text-xs text-muted w-8 text-right">@((int)(_settings.AudioDuckingSystemVolume * 100))%</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="settings-card-desc">Volume musique</span>
                                <div class="flex items-center gap-2">
                                    <input type="range" min="0" max="100" value="@((int)(_settings.AudioDuckingMusicVolume * 100))" class="settings-range w-24" @oninput="e => _settings.AudioDuckingMusicVolume = ParseSliderFloat(e.Value?.ToString(), 10f) / 100" />
                                    <span class="text-xs text-muted w-8 text-right">@((int)(_settings.AudioDuckingMusicVolume * 100))%</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="settings-card-desc">Duree du fondu</span>
                                <div class="flex items-center gap-2">
                                    <input type="range" min="200" max="3000" step="100" value="@_settings.AudioDuckingFadeMs" class="settings-range w-24" @oninput="e => _settings.AudioDuckingFadeMs = ParseSliderInt(e.Value?.ToString(), 1500)" />
                                    <span class="text-xs text-muted w-10 text-right">@_settings.AudioDuckingFadeMs ms</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="settings-card-desc">Apps exclues</span>
                                <input type="text" @bind="_settings.AudioDuckingExcludedApps" placeholder="obs64.exe, discord.exe" class="settings-input max-w-[200px]" />
                            </div>
                        </div>
                    }
                </div>

                <div class="flex justify-end">
                    <button class="settings-btn-primary" @onclick="OnSave">Enregistrer la voix</button>
                </div>
            </div>
        }

        @* ── IA & Models ── *@
        @if (_activeTab == "ai")
        {
            <div class="space-y-3 mb-6" data-search-group="ai">
                <div class="settings-card-label">Smart Routing</div>
                <div class="settings-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="settings-card-title">Selection intelligente</div>
                            <div class="settings-card-desc">Jarvis choisit le meilleur modele selon la complexite</div>
                        </div>
                        <label class="settings-toggle">
                            <input type="checkbox" class="sr-only peer" @bind="_smart.Enabled" @bind:after="SaveSmartRouting" />
                            <div class="settings-toggle-track"></div>
                        </label>
                    </div>
                </div>
                <div class="settings-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="settings-card-title">Adapter aussi pour la voix</div>
                            <div class="settings-card-desc">Adapter le modele pour les commandes vocales</div>
                        </div>
                        <label class="settings-toggle">
                            <input type="checkbox" class="sr-only peer" @bind="_smart.VoiceEnabled" @bind:after="SaveSmartRouting" />
                            <div class="settings-toggle-track"></div>
                        </label>
                    </div>
                </div>
                <div class="settings-card">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="settings-card-title">Taches multi-etapes</div>
                            <div class="settings-card-desc">Mode plan + execution pour les projets complexes</div>
                        </div>
                        <label class="settings-toggle">
                            <input type="checkbox" class="sr-only peer" @bind="_smart.MultiStepEnabled" @bind:after="SaveSmartRouting" />
                            <div class="settings-toggle-track"></div>
                        </label>
                    </div>
                </div>

                <div class="settings-card-label mt-4">Tester le routage</div>
                <div class="settings-card">
                    <div class="settings-card-desc mb-3">Saisissez une demande pour voir quel modele Jarvis utiliserait</div>
                    <div class="flex gap-2">
                        <input class="settings-input flex-1" @bind="_testText" placeholder="Ex: corrige ce bug, ecris un projet web..." />
                        <button class="settings-btn-primary" @onclick="OnTestRouting" disabled="@_testing">@(_testing ? "Analyse..." : "Tester")</button>
                    </div>
                    @if (_smartResult is not null)
                    {
                        <div class="mt-3 rounded-lg border border-border bg-surface p-3 text-sm space-y-1.5">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="jarvis-chip">@_smartResult.Model</span>
                                <span class="text-[10px] text-muted">@_smartResult.Profile</span>
                                @if (_smartResult.Success) { <span class="text-[10px] text-muted">· @(_smartResult.ElapsedMs) ms</span> }
                            </div>
                            <div class="text-xs text-muted">@_smartResult.Reason</div>
                            @if (_smartResult.MultiStep) { <div class="text-xs text-acent">Tache multi-etapes</div> }
                            @if (!string.IsNullOrWhiteSpace(_smartResult.Response)) { <div class="border-t border-border pt-2 mt-1 whitespace-pre-wrap text-primary">@_smartResult.Response</div> }
                            @if (!_smartResult.Success && !string.IsNullOrWhiteSpace(_smartResult.Error)) { <div class="text-xs text-red-400">Erreur : @_smartResult.Error</div> }
                        </div>
                    }
                </div>

                <div class="settings-card-label mt-4">Fournisseurs IA</div>
                <div class="space-y-2">
                    @foreach (var p in _providers)
                    {
                        var isOpen = _expandedProviderKey == p.Key;
                        <div class="settings-card @(isOpen ? "border-accent/30" : "")">
                            <div class="flex items-center gap-2">
                                <button class="shrink-0 w-7 h-7 rounded-lg hover:bg-mainbg flex items-center justify-center text-muted hover:text-primary bg-transparent border-0 cursor-pointer transition-transform @(isOpen ? "rotate-90" : "")" @onclick="() => ToggleProvider(p)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"/></svg>
                                </button>
                                <div class="flex-1 min-w-0">
                                    <input class="w-full bg-transparent border border-transparent hover:border-border focus:border-border rounded-lg px-2 py-1 text-sm font-medium text-primary outline-none" @bind="p.DisplayName" />
                                    <div class="text-xs text-muted px-2 truncate">@p.Description</div>
                                </div>
                                <label class="settings-toggle shrink-0">
                                    <input type="checkbox" class="sr-only peer" @bind="p.Enabled" />
                                    <div class="settings-toggle-track"></div>
                                </label>
                            </div>
                            @if (isOpen)
                            {
                                <div class="mt-3 pt-3 border-t border-border">
                                    <div class="grid grid-cols-2 gap-3">
                                        <div><label class="settings-card-desc">Endpoint</label><input class="settings-input mt-1" @bind="p.BaseUrl" placeholder="https://..." /></div>
                                        <div><label class="settings-card-desc">@(p.RequiresKey ? "Cle API" : "Cle API (optionnel)")</label><input type="password" class="settings-input mt-1" @bind="p.ApiKey" placeholder="sk-..." /></div>
                                    </div>
                                    <div class="flex items-center gap-3 mt-3">
                                        <div class="flex-1"><label class="settings-card-desc">Modele par defaut</label><select class="settings-select mt-1" @bind="p.DefaultModel">
                                            @foreach (var m in ProviderModels(p)) { <option value="@m">@m</option> }
                                        </select></div>
                                        <button class="settings-btn-secondary mt-4" @onclick="() => TestProvider(p)" disabled="@(_providerTestingKey == p.Key)">@(_providerTestingKey == p.Key ? "Test..." : "Tester")</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <button class="settings-btn-secondary w-full" @onclick="ToggleAddPanel">
                        + Ajouter un fournisseur
                    </button>
                    <div class="flex justify-end mt-3">
                        <button class="settings-btn-primary" @onclick="SaveProviders" disabled="@_providersSaving">@(_providersSaving ? "Enregistrement..." : "Enregistrer les fournisseurs")</button>
                    </div>
                </div>
            </div>
        }

        @* ── Appearance ── *@
        @if (_activeTab == "appearance")
        {
            <div class="space-y-3 mb-6" data-search-group="appearance">
                <div class="settings-card-label">Theme</div>
                <div class="settings-card">
                    <div class="settings-card-desc mb-3">Choisir un preset de theme pour l'interface</div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                        @foreach (var t in _themes)
                        {
                            <button class="p-3 rounded-xl border-2 text-left transition-all cursor-pointer @(_activeTheme == t.Id ? "border-[rgb(var(--accent))]" : "border-border hover:border-muted")"
                                    style="background:@t.Preview" @onclick="() => ApplyTheme(t.Id)">
                                <div class="text-xs font-semibold" style="color:@t.TextColor">@t.Name</div>
                                <div class="text-[10px] mt-1" style="color:@t.TextMuted">@t.Desc</div>
                            </button>
                        }
                    </div>
                </div>

                <div class="settings-card-label">Couleur d'accentuation</div>
                <div class="settings-card">
                    <div class="flex flex-wrap items-center gap-2">
                        @foreach (var c in _accentSwatches)
                        {
                            <button class="w-8 h-8 rounded-full border-2 transition-transform hover:scale-110 cursor-pointer @(_accentColor == c.Value ? "ring-2 ring-primary" : "border-border")"
                                    style="background-color:@c.Value" title="@c.Name"
                                    @onclick="() => SelectAccent(c.Value)"></button>
                        }
                        <input type="color" value="@_accentColor" class="w-8 h-8 rounded cursor-pointer bg-transparent border-0 p-0"
                               title="Couleur personnalisee" @onchange="OnCustomAccent" />
                    </div>
                    <div class="text-[11px] text-muted mt-2">@(_accentColor)</div>
                </div>

                <div class="settings-card-label mt-4">Profils de configuration</div>
                <div class="settings-card">
                    <div class="flex items-center gap-3 mb-3">
                        <select @bind="_selectedProfile" class="settings-select" style="max-width:200px">
                            @foreach (var p in _profiles) { <option value="@p">@p</option> }
                        </select>
                        <button class="settings-btn-primary" @onclick="LoadProfile">Charger</button>
                        <button class="settings-btn-secondary" @onclick="SaveAsProfile">Sous...</button>
                        @if (_selectedProfile != "default")
                        {
                            <button class="settings-btn-secondary text-red-400 hover:bg-red-500/10" @onclick="DeleteProfile">Supprimer</button>
                        }
                    </div>
                    <div class="flex gap-2">
                        <button class="settings-btn-secondary" @onclick="ExportConfig">Exporter JSON</button>
                        <button class="settings-btn-secondary" @onclick="ImportConfig">Importer JSON</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_profileStatus)) { <div class="text-xs text-accent mt-2">@_profileStatus</div> }
                </div>
            </div>
        }

        @* ── Integrations ── *@
        @if (_activeTab == "integrations")
        {
            <div class="space-y-3 mb-6" data-search-group="integrations">
                <div class="settings-card-label">Integ. externes</div>
                <div class="settings-card">
                    <div class="settings-card-desc mb-3">Google, Discord, Twilio, Instagram, Hermes, Alexa, Home Assistant. Stocks localement.</div>
                    @if (_integ is null)
                    {
                        <button class="settings-btn-primary" @onclick="LoadIntegrations">Charger les identifiants</button>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <label class="block"><span class="settings-card-desc">Google Client ID</span><input type="password" class="settings-input mt-1" @bind="_integ.Google.ClientId" /></label>
                            <label class="block"><span class="settings-card-desc">Google Client Secret</span><input type="password" class="settings-input mt-1" @bind="_integ.Google.ClientSecret" /></label>
                            <label class="block md:col-span-2"><span class="settings-card-desc">Google Refresh Token</span><input type="password" class="settings-input mt-1" @bind="_integ.Google.RefreshToken" /></label>
                            <label class="block"><span class="settings-card-desc">Discord Bot token</span><input type="password" class="settings-input mt-1" @bind="_integ.Discord.BotToken" /></label>
                            <label class="block"><span class="settings-card-desc">Discord User/Guild ID</span><div class="flex gap-2 mt-1"><input class="settings-input" @bind="_integ.Discord.UserId" /><input class="settings-input" @bind="_integ.Discord.GuildId" /></div></label>
                            <label class="block"><span class="settings-card-desc">Twilio Account SID</span><input type="password" class="settings-input mt-1" @bind="_integ.Twilio.AccountSid" /></label>
                            <label class="block"><span class="settings-card-desc">Twilio Auth Token / Numero</span><div class="flex gap-2 mt-1"><input type="password" class="settings-input" @bind="_integ.Twilio.AuthToken" /><input class="settings-input" style="max-width:120px" @bind="_integ.Twilio.Numero" placeholder="+33..." /></div></label>
                            <label class="block"><span class="settings-card-desc">Home Assistant URL</span><input class="settings-input mt-1" @bind="_integ.HomeAssistant.Url" /></label>
                            <label class="block"><span class="settings-card-desc">Home Assistant Token</span><input type="password" class="settings-input mt-1" @bind="_integ.HomeAssistant.Token" /></label>
                            <label class="block"><span class="settings-card-desc">Alexa Token</span><input type="password" class="settings-input mt-1" @bind="_integ.Alexa.AccessToken" /></label>
                            <label class="block"><span class="settings-card-desc">Hermes API URL</span><input class="settings-input mt-1" @bind="_integ.Hermes.ApiUrl" /></label>
                            <label class="block"><span class="settings-card-desc">Hermes Cle API</span><input type="password" class="settings-input mt-1" @bind="_integ.Hermes.ApiKey" /></label>
                        </div>
                        <div class="flex items-center gap-2 mt-3">
                            <button class="settings-btn-primary" @onclick="SaveIntegrations" disabled="@_savingIntegrations">Enregistrer</button>
                            @foreach (var (cle, libelle) in new[] { ("google", "Google"), ("discord", "Discord"), ("twilio", "Twilio"), ("alexa", "Alexa"), ("homeassistant", "HA") })
                            {
                                var k = cle;
                                <button class="settings-btn-secondary" @onclick="() => TestIntegration(k)" disabled="@(_testingIntegration == k)">@(k == _testedIntegration && _integrationTestOk ? "OK" : k == _testedIntegration && !_integrationTestOk ? "X" : libelle)</button>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_integrationTestInfo)) { <div class="text-xs mt-2 @(_integrationTestOk ? "text-muted" : "text-red-400")">@_integrationTestInfo</div> }
                    }
                </div>
            </div>
        }

        @* ── System ── *@
        @if (_activeTab == "system")
        {
            <div class="space-y-3 mb-6" data-search-group="system">
                <div class="settings-card-label">Modeles Ollama</div>
                <div class="settings-card">
                    <div class="settings-card-desc mb-2">Dossier de telechargement des modeles</div>
                    <div class="flex gap-2">
                        <input class="settings-input flex-1" @bind="_modelsPath" placeholder="Ex. D:\modeles ia" />
                        <button class="settings-btn-primary" @onclick="SaveModelsPath" disabled="@(_savingModelsPath)">Enregistrer</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_modelsPathInfo)) { <div class="text-xs mt-2 @(_modelsPathInfo.StartsWith("Erreur") ? "text-red-400" : "text-muted")">@_modelsPathInfo</div> }
                </div>

                <div class="settings-card-label mt-4">Application</div>
                <div class="settings-card">
                    <div class="flex items-center justify-between mb-3">
                        <div><div class="settings-card-title">Relancer Jarvis</div><div class="settings-card-desc">Redemarre le serveur et l'interface</div></div>
                        <button class="settings-btn-primary" @onclick="OnRestart">Relancer</button>
                    </div>
                    <div class="flex items-center justify-between">
                        <div><div class="settings-card-title">Arreter Jarvis</div><div class="settings-card-desc">Ferme complètement l'application</div></div>
                        <button class="settings-btn-secondary text-red-400 hover:bg-red-500/10 border-red-500/20" @onclick="OnStop">Arreter</button>
                    </div>
                </div>
            </div>
        }

        @* ── Advanced (60+ settings) ── *@
        @if (_activeTab == "advanced")
        {
            <div class="space-y-2 mb-6" data-search-group="advanced">
                <div class="flex gap-1 mb-2 flex-wrap">
                    @foreach (var (key, label) in new[] { ("ia","IA"), ("memoire","Memoire"), ("outils","Outils"), ("securite","Securite"), ("notif","Notif."), ("auto","Auto."), ("ui","UI"), ("models","Modeles") })
                    {
                        var isActive = _advSub == key;
                        <button class="settings-tab @(isActive ? "active" : "")" @onclick="() => ToggleAdvSub(key)">@label</button>
                    }
                </div>

                <div class="settings-adv-content @(_advExpanded ? "expanded" : "")" id="adv-content">
                @if (_advSub == "ia")
                {
                    <div class="grid grid-cols-2 gap-2">
                        <div class="settings-card"><div class="settings-card-desc">Temperature</div><div class="flex items-center gap-1"><input type="range" min="0" max="200" value="@((int)(_adv.Temperature * 100))" class="settings-range flex-1" @oninput="e => _adv.Temperature = ParseSliderFloat(e.Value?.ToString(), 70f) / 100" /><span class="text-[10px] text-muted w-8 text-right">@(_adv.Temperature.ToString("F2"))</span></div></div>
                        <div class="settings-card"><div class="settings-card-desc">Max tokens</div><input type="number" class="settings-input" @bind="_adv.MaxTokens" min="256" max="32768" step="256" /></div>
