    private void OnSecretTap()
    {
        var now = DateTime.UtcNow;
        if ((now - _secretTapStart).TotalSeconds > 3) _secretTaps = 0;
        _secretTapStart = now;
        _secretTaps++;
        if (_secretTaps >= 15)
        {
            _secretTaps = 0;
            _showSecretUnlock = true;
            _secretDebugStatus = "";
            _debugPassword = "";
        }
    }

