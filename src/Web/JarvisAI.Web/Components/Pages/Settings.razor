    private void OnSearchChanged()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchResults.Clear();
            return;
        }
        if (_searchIndex.Count == 0) BuildSearchIndex();

        var query = _searchQuery.ToLowerInvariant().Trim();
        var words = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        _searchResults = _searchIndex
            .Where(e => words.All(w => e.Keywords.Contains(w, StringComparison.OrdinalIgnoreCase) ||
                                       e.Label.Contains(w, StringComparison.OrdinalIgnoreCase) ||
                                       e.Description.Contains(w, StringComparison.OrdinalIgnoreCase)))
            .Select(e => new SearchResult { Category = e.Category, Label = e.Label, Description = e.Description, Tab = e.Tab })
            .OrderBy(r => r.Label)
            .Take(10)
            .ToList();
    }

    private void JumpToResult(SearchResult result)
    {
        _activeTab = result.Tab;
        _searchQuery = "";
        _searchResults.Clear();
    }

    private void SetTab(string tab) { _activeTab = tab; _searchQuery = ""; _searchResults.Clear(); }

    private void ToggleAdvSub(string key)
    {
        if (_advSub == key)
        {
            _advExpanded = !_advExpanded;
        }
        else
        {
            _advSub = key;
            _advExpanded = false;
        }
    }

    private async Task ApplyTheme(string themeId)
    {
        _activeTheme = themeId;
        // Remove all theme classes from root
        await JS.InvokeVoidAsync("eval", "document.documentElement.classList.remove('theme-oled','theme-sombre','theme-neon','theme-lavande')");
        // Clear inline accent overrides so the CSS class accent takes effect
        await JS.InvokeVoidAsync("eval", "document.documentElement.style.removeProperty('--accent'); document.documentElement.style.removeProperty('--accent-hover'); document.documentElement.style.removeProperty('--accent-glow'); document.documentElement.style.removeProperty('--accent-subtle'); document.documentElement.style.removeProperty('--border-glow');");
        // Apply selected theme (sombre is default, no class needed)
        if (themeId != "sombre")
            await JS.InvokeVoidAsync("eval", $"document.documentElement.classList.add('theme-{themeId}')");
        // Save preference
        try { await JS.InvokeVoidAsync("jarvis.setPref", "theme", themeId); } catch { }
        // Update accent swatch to match theme default
        var themeAccent = themeId switch
        {
            "oled" => "#b41e1e",
            "neon" => "#00ff64",
            "lavande" => "#a855f7",
            _ => "#3b82f6"
        };
        _accentColor = themeAccent;
        try { await JS.InvokeVoidAsync("jarvis.setPref", "accentColor", themeAccent); } catch { }
        StateHasChanged();
    }

