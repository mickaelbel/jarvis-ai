        _expandedProviderKey = custom.Key;
        _showAddPanel = false;
        StateHasChanged();
    }

    private void AddCatalogProvider(string key)
    {
        var template = _availableToAdd.FirstOrDefault(a => a.Key == key);
        if (template is null) return;

        var provider = new ProviderViewModel
        {
            Key = template.Key,
            DisplayName = template.DisplayName,
            Description = template.Description,
            RequiresKey = template.RequiresKey,
            Enabled = true,
            Added = true,
            ApiKey = template.ApiKey,
            BaseUrl = template.BaseUrl,
            DefaultModel = template.DefaultModel,
            ChatPath = template.ChatPath,
            Models = template.Models,
            Prefixes = template.Prefixes,
            CustomModels = template.CustomModels
        };
        _providers.Add(provider);
        _availableToAdd.RemoveAll(a => a.Key == template.Key);
        _providerResults.Remove(template.Key);
        _expandedProviderKey = template.Key;
        _showAddPanel = false;
        StateHasChanged();
    }

