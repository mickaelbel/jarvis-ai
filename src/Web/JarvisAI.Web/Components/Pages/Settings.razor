@page "/settings"
@rendermode InteractiveServer
@using System.Text
@using System.Text.Json

<div class="max-w-3xl mx-auto px-4 md:px-6 py-8">
    <h1 class="text-xl font-semibold text-primary mb-6">Jarvis Voice</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
        <div class="px-4 py-3 rounded-xl bg-surface/60 border border-border">
            <div class="text-xs text-muted mb-1.5">Microphone</div>
            <select class="w-full bg-mainbg border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none cursor-pointer" @onchange="OnMicChanged">
                @foreach (var mic in _mics)
                {
                    <option value="@mic.Id" selected="@(mic.Id == _settings.MicDeviceId)">@mic.Label</option>
                }
            </select>
        </div>

        <div class="px-4 py-3 rounded-xl bg-surface/60 border border-border">
            <div class="text-xs text-muted mb-1.5">Haut-parleur</div>
            <select class="w-full bg-mainbg border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none cursor-pointer" @onchange="OnSpeakerChanged">
                @foreach (var spk in _speakers)
                {
                    <option value="@spk.Id" selected="@(spk.Id == _settings.SpeakerDeviceId)">@spk.Label</option>
                }
            </select>
        </div>

        <div class="px-4 py-3 rounded-xl bg-surface/60 border border-border">
            <div class="text-xs text-muted mb-1.5">Voix (TTS)</div>
            <div class="flex gap-2">
                <select class="flex-1 bg-mainbg border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none cursor-pointer" @onchange="OnVoiceChanged">
                    @foreach (var v in _voices)
                    {
                        <option value="@v" selected="@(v == _settings.TtsVoice)">@GetVoiceDisplayName(v)</option>
                    }
                </select>
                <button class="text-xs bg-accent hover:bg-accent-hover text-primary rounded-lg px-3 py-1.5 shrink-0" @onclick="OnTestTts">Tester</button>
            </div>
        </div>

        <div class="px-4 py-3 rounded-xl bg-surface/60 border border-border">
            <div class="text-xs text-muted mb-1.5">Modèle IA</div>
            <div class="flex gap-2">
                <select class="flex-1 bg-mainbg border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none cursor-pointer" @bind="_settings.Model" @bind:after="OnVoiceModelChanged">
                    <option value="">Auto (défaut)</option>
                    @if (_settings.Model is { Length: > 0 } custom && !_availableModels.Any(m => m.Name == custom))
                    {
                        <option value="@custom">@custom</option>
                    }
                    @foreach (var group in _availableModelGroups)
                    {
                        <optgroup label="@group.Label">
                            @foreach (var m in group.Models)
                            {
                                <option value="@m.Name">@m.Name</option>
                            }
                        </optgroup>
                    }
                </select>
                <button class="text-xs bg-surface border border-border hover:bg-surface/70 text-primary rounded-lg px-3 py-1.5 shrink-0 cursor-pointer" @onclick="TestVoiceModel" disabled="@_voiceTesting">@(_voiceTesting ? "…" : "Tester")</button>
            </div>
            @if (_voiceTestResult is not null)
            {
                <div class="text-[11px] mt-1">@(_voiceTestResult.Success ? $"✔ {_voiceTestResult.Model}" : $"✗ {_voiceTestResult.Error}")</div>
            }
        </div>
    </div>

    <div class="px-4 py-3 rounded-xl bg-surface/60 border border-border mb-4">
        <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-medium text-primary">Volume</div>
            <span class="text-xs text-muted">@((int)(_settings.Volume * 100))%</span>
        </div>
        <input type="range" min="0" max="100" value="@((int)(_settings.Volume * 100))" class="w-full accent-accent" @oninput="OnVolumeChanged" />
    </div>

    <div class="px-4 py-3 rounded-xl bg-surface/60 border border-border mb-6">
        <div class="flex items-center justify-between">
            <div>
                <div class="text-sm font-medium text-primary">Baisse de volume auto</div>
                <div class="text-xs text-muted">Baisse le volume des autres apps quand Jarvis parle</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" class="sr-only peer" @bind="_settings.AudioDuckingEnabled" />
                <div class="w-9 h-5 bg-border rounded-full peer peer-checked:bg-accent after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-primary after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
            </label>
        </div>
        @if (_settings.AudioDuckingEnabled)
        {
            <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted">Volume système</span>
                    <div class="flex items-center gap-2">
                        <input type="range" min="0" max="100" value="@((int)(_settings.AudioDuckingSystemVolume * 100))" class="w-24 accent-accent" @oninput="e => _settings.AudioDuckingSystemVolume = ParseSliderFloat(e.Value?.ToString(), 30f) / 100" />
                        <span class="text-xs text-muted w-8 text-right">@((int)(_settings.AudioDuckingSystemVolume * 100))%</span>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted">Volume musique</span>
                    <div class="flex items-center gap-2">
                        <input type="range" min="0" max="100" value="@((int)(_settings.AudioDuckingMusicVolume * 100))" class="w-24 accent-accent" @oninput="e => _settings.AudioDuckingMusicVolume = ParseSliderFloat(e.Value?.ToString(), 10f) / 100" />
                        <span class="text-xs text-muted w-8 text-right">@((int)(_settings.AudioDuckingMusicVolume * 100))%</span>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted">Durée du fondu</span>
                    <div class="flex items-center gap-2">
                        <input type="range" min="200" max="3000" step="100" value="@_settings.AudioDuckingFadeMs" class="w-24 accent-accent" @oninput="e => _settings.AudioDuckingFadeMs = ParseSliderInt(e.Value?.ToString(), 1500)" />
                        <span class="text-xs text-muted w-10 text-right">@_settings.AudioDuckingFadeMs ms</span>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted">Apps exclues</span>
                    <input type="text" @bind="_settings.AudioDuckingExcludedApps" placeholder="obs64.exe, discord.exe" class="max-w-[200px] bg-mainbg border border-border rounded-lg px-3 py-1.5 text-xs text-primary outline-none" />
                </div>
                <div class="flex items-center justify-between md:col-span-2">
                    <span class="text-xs text-muted">Raccourci clavier</span>
                    <input type="text" @bind="_settings.AudioDuckingShortcut" placeholder="Ctrl+Shift+D" class="max-w-[200px] bg-mainbg border border-border rounded-lg px-3 py-1.5 text-xs text-primary outline-none" />
                </div>
            </div>
        }
    </div>

    <div class="px-4 py-3 rounded-xl bg-surface/60 border border-border mb-4">
        <div class="text-xs text-muted mb-1.5">Couleur d'accentuation</div>
        <div class="flex flex-wrap items-center gap-2">
            @foreach (var c in _accentSwatches)
            {
                <button class="w-8 h-8 rounded-full border-2 transition-transform hover:scale-110 cursor-pointer @(_accentColor == c.Value ? "ring-2 ring-primary" : "border-border")"
                        style="background-color:@c.Value"
                        title="@c.Name"
                        @onclick="() => SelectAccent(c.Value)"></button>
            }
            <input type="color" value="@_accentColor" class="w-8 h-8 rounded cursor-pointer bg-transparent border-0 p-0"
                   title="Couleur personnalisée"
                   @onchange="OnCustomAccent" />
        </div>
        <div class="text-[11px] text-muted mt-2">@(_accentColor)</div>
    </div>

    <div class="flex justify-end mb-8">
        <button class="bg-accent hover:bg-accent-hover text-primary rounded-lg px-5 py-2 text-sm font-medium" @onclick="OnSave">Enregistrer</button>
    </div>

    <h2 class="text-sm font-semibold text-muted uppercase tracking-wide mb-3 mt-8">Profils de configuration</h2>
    <div class="bg-surface rounded-xl border border-border p-4 mb-8">
        <div class="flex items-center gap-3 mb-3">
            <select @bind="_selectedProfile" class="bg-mainbg border border-border rounded-lg px-3 py-1.5 text-xs text-primary outline-none">
                @foreach (var p in _profiles)
                {
                    <option value="@p">@p</option>
                }
            </select>
            <button class="text-xs px-3 py-1.5 rounded-lg bg-accent text-white hover:bg-accent-hover transition-colors border-0 cursor-pointer" @onclick="LoadProfile">Charger</button>
            <button class="text-xs px-3 py-1.5 rounded-lg bg-surface border border-border text-primary hover:bg-surface2 transition-colors cursor-pointer" @onclick="SaveAsProfile">Sous…</button>
            @if (_selectedProfile != "default")
            {
                <button class="text-xs px-3 py-1.5 rounded-lg bg-red-500/20 text-red-400 hover:bg-red-500/30 transition-colors border-0 cursor-pointer" @onclick="DeleteProfile">Supprimer</button>
            }
        </div>
        <div class="flex gap-2">
            <button class="text-xs px-3 py-1.5 rounded-lg bg-surface border border-border text-primary hover:bg-surface2 transition-colors cursor-pointer" @onclick="ExportConfig">Exporter JSON</button>
            <button class="text-xs px-3 py-1.5 rounded-lg bg-surface border border-border text-primary hover:bg-surface2 transition-colors cursor-pointer" @onclick="ImportConfig">Importer JSON</button>
        </div>
        @if (!string.IsNullOrEmpty(_profileStatus))
        {
            <div class="text-xs text-accent mt-2">@_profileStatus</div>
        }
    </div>

    <h2 class="text-sm font-semibold text-muted uppercase tracking-wide mb-3 mt-8">Fournisseurs IA</h2>
    <div class="space-y-2 mb-8">
        @if (_providers.Count == 0)
        {
            <div class="px-4 py-8 rounded-xl border border-dashed border-border text-center text-xs text-muted">
                Aucun fournisseur configuré. Cliquez sur « Ajouter un fournisseur » pour connecter un endpoint IA.
            </div>
        }
        @foreach (var p in _providers)
        {
            var isOpen = _expandedProviderKey == p.Key;
            <div class="rounded-xl border @(isOpen ? "border-accent/40 bg-surface" : "border-border bg-surface/40") transition-colors">
                <div class="flex items-center gap-2 px-3 py-2.5">
                    <button class="shrink-0 w-7 h-7 rounded-lg hover:bg-mainbg flex items-center justify-center text-muted hover:text-primary bg-transparent border-0 cursor-pointer transition-transform @(isOpen ? "rotate-90" : "")" @onclick="() => ToggleProvider(p)" title="Afficher / masquer la configuration">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                    <div class="flex-1 min-w-0">
                        <input class="w-full bg-transparent border border-transparent hover:border-border focus:border-border rounded-lg px-2 py-1 text-sm font-medium text-primary outline-none" @bind="p.DisplayName" placeholder="Nom du fournisseur" />
                        <div class="text-xs text-muted px-2 truncate">@p.Description</div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0" title="Activer / désactiver">
                        <input type="checkbox" class="sr-only peer" @bind="p.Enabled" />
                        <div class="w-9 h-5 bg-border rounded-full peer peer-checked:bg-accent after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-primary after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
                    </label>
                    <button class="shrink-0 text-xs text-muted hover:text-red-400 bg-transparent border-0 cursor-pointer px-2 py-1 rounded-lg hover:bg-red-500/10 transition-colors" @onclick="() => RemoveProvider(p)" title="Supprimer ce fournisseur">Supprimer</button>
                </div>
                @if (isOpen)
                {
                    <div class="px-3 pb-4 border-t border-border">
                        <div class="grid grid-cols-2 gap-3 mt-3">
                            <div>
                                <label class="text-[11px] text-muted">Endpoint (URL de base)</label>
                                <input class="w-full bg-surface border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none placeholder:text-muted" @bind="p.BaseUrl" placeholder="https://..." />
                            </div>
                            <div>
                                <label class="text-[11px] text-muted">@(p.RequiresKey ? "Clé API" : "Clé API (optionnel)")</label>
                                <input type="password" class="w-full bg-surface border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none placeholder:text-muted" @bind="p.ApiKey" placeholder="sk-..." />
                            </div>
                        </div>
                        <div class="flex items-center gap-3 mt-3">
                            <div class="flex-1">
                                <label class="text-[11px] text-muted">Modèle par défaut</label>
                                <select class="w-full bg-surface border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none cursor-pointer" @bind="p.DefaultModel">
                                    @if (!string.IsNullOrWhiteSpace(p.DefaultModel) && !ProviderModels(p).Contains(p.DefaultModel))
                                    {
                                        <option value="@p.DefaultModel">@p.DefaultModel</option>
                                    }
                                    @foreach (var m in ProviderModels(p))
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </select>
                            </div>
                            <button class="bg-surface border border-border hover:bg-surface/70 text-primary rounded-lg px-3 py-1.5 text-xs cursor-pointer mt-4" @onclick="() => TestProvider(p)" disabled="@(_providerTestingKey == p.Key)">@(_providerTestingKey == p.Key ? "Test…" : "Tester")</button>
                        </div>
                        @if (_providerResults.TryGetValue(p.Key, out var pr) && pr is not null)
                        {
                            <div class="mt-2 text-xs space-y-1">
                                @if (pr.Success)
                                {
                                    <div class="text-accent">✔ @pr.Model · @pr.ElapsedMs ms</div>
                                    @if (!string.IsNullOrWhiteSpace(pr.Response))
                                    {
                                        <div class="whitespace-pre-wrap text-muted max-h-24 overflow-y-auto">@pr.Response</div>
                                    }
                                }
                                else
                                {
                                    <div class="text-red-400">Erreur : @pr.Error</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        <div class="pt-2">
            @if (!_showAddPanel)
            {
                <button class="flex items-center gap-2 text-xs font-medium text-accent hover:text-accent-hover bg-accent/10 hover:bg-accent/20 rounded-lg px-3 py-2 border-0 cursor-pointer transition-colors" @onclick="ToggleAddPanel">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Ajouter un fournisseur
                </button>
            }
            else
            {
                <div class="rounded-xl border border-border bg-surface p-3">
                    <div class="text-xs font-medium text-muted mb-2">Choisir un fournisseur à ajouter</div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <button class="flex items-center gap-2 text-left px-3 py-2 rounded-lg hover:bg-mainbg transition-colors bg-transparent border-0 cursor-pointer text-xs text-primary" @onclick="AddCustomProvider">
                            <span class="shrink-0 w-6 h-6 rounded bg-accent/10 text-accent flex items-center justify-center text-[11px] font-bold">＋</span>
                            <span>
                                <span class="font-medium block">Personnalisé</span>
                                <span class="text-muted block text-[11px]">Endpoint OpenAI-compatible, libre</span>
                            </span>
                        </button>
                        @foreach (var a in _availableToAdd)
                        {
                            <button class="flex items-center gap-2 text-left px-3 py-2 rounded-lg hover:bg-mainbg transition-colors bg-transparent border-0 cursor-pointer text-xs text-primary" @onclick="() => AddCatalogProvider(a.Key)">
                                <span class="shrink-0 w-6 h-6 rounded bg-accent/10 text-accent flex items-center justify-center text-[11px] font-bold">＋</span>
                                <span>
                                    <span class="font-medium block">@a.DisplayName</span>
                                    <span class="text-muted block text-[11px]">@a.Description</span>
                                </span>
                            </button>
                        }
                    </div>
                    <button class="mt-3 text-xs text-muted hover:text-primary bg-transparent border-0 cursor-pointer" @onclick="ToggleAddPanel">Annuler</button>
                </div>
            }
            <div class="flex items-center gap-3 mt-3">
                <div class="flex-1"></div>
                @if (!string.IsNullOrEmpty(_providersStatus))
                {
                    <span class="text-xs text-muted">@_providersStatus</span>
                }
                <button class="bg-accent hover:bg-accent-hover text-primary rounded-lg px-5 py-2 text-sm font-medium" @onclick="SaveProviders" disabled="@_providersSaving">@(_providersSaving ? "Enregistrement…" : "Enregistrer les fournisseurs")</button>
            </div>
        </div>
    </div>

    <h2 class="text-sm font-semibold text-muted uppercase tracking-wide mb-3 mt-8">Routage intelligent</h2>
    <div class="space-y-1 mb-8">
        <div class="px-4 py-4 rounded-xl hover:bg-surface/50 transition-colors">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-primary">Sélection intelligente</div>
                    <div class="text-xs text-muted">Jarvis choisit le meilleur modèle selon la complexité de la demande</div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" class="sr-only peer" @bind="_smart.Enabled" @bind:after="SaveSmartRouting" />
                    <div class="w-9 h-5 bg-border rounded-full peer peer-checked:bg-accent after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-primary after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
                </label>
            </div>
        </div>

        <div class="px-4 py-4 rounded-xl hover:bg-surface/50 transition-colors">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-primary">Voix</div>
                    <div class="text-xs text-muted">Adapter aussi le modèle pour les commandes vocales</div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" class="sr-only peer" @bind="_smart.VoiceEnabled" @bind:after="SaveSmartRouting" />
                    <div class="w-9 h-5 bg-border rounded-full peer peer-checked:bg-accent after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-primary after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
                </label>
            </div>
        </div>

        <div class="px-4 py-4 rounded-xl hover:bg-surface/50 transition-colors">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-primary">Tâches multi-étapes</div>
                    <div class="text-xs text-muted">Passer en mode plan + exécution pour les projets complexes</div>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" class="sr-only peer" @bind="_smart.MultiStepEnabled" @bind:after="SaveSmartRouting" />
                    <div class="w-9 h-5 bg-border rounded-full peer peer-checked:bg-accent after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-primary after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
                </label>
            </div>
        </div>

        <div class="px-4 py-4 rounded-xl hover:bg-surface/50 transition-colors">
            <div class="text-sm font-medium text-primary mb-1">Tester le choix du modèle</div>
            <div class="text-xs text-muted mb-3">Saisissez une demande pour voir quel modèle Jarvis utiliserait, puis exécuter réellement le test avec ce modèle (et proposer un téléchargement si le meilleur n'est pas installé)</div>
            <div class="flex gap-2">
                <input class="flex-1 bg-surface border border-border rounded-lg px-3 py-1.5 text-sm text-primary outline-none placeholder:text-muted" @bind="_testText" placeholder="Ex : corrige ce bug dans mon script, écris un projet web..." />
                <button class="bg-accent hover:bg-accent-hover text-primary rounded-lg px-4 py-1.5 text-sm" @onclick="OnTestRouting" disabled="@_testing">@(_testing ? "Analyse…" : "Tester")</button>
            </div>
            @if (_smartResult is not null)
            {
                <div class="mt-3 rounded-lg border border-border bg-surface p-3 text-sm space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="jarvis-chip">@_smartResult.Model</span>
                        <span class="text-[10px] text-muted">@_smartResult.Profile</span>
                        @if (_smartResult.Success)
                        {
                            <span class="text-[10px] text-muted">· @(_smartResult.ElapsedMs) ms</span>
                        }
                    </div>
                    <div class="text-xs text-muted">@_smartResult.Reason</div>
                    @if (_smartResult.MultiStep)
                    {
                        <div class="text-xs text-accent">Tâche multi-étapes : plan puis exécution</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_smartResult.Response))
                    {
                        <div class="border-t border-border pt-2 mt-1 whitespace-pre-wrap text-primary">@_smartResult.Response</div>
                    }
                    @if (!_smartResult.Success && !string.IsNullOrWhiteSpace(_smartResult.Error))
                    {
                        <div class="text-xs text-red-400">Erreur : @_smartResult.Error</div>
                    }
                    @if (_smartResult.DownloadSuggestion is not null)
                    {
                        <div class="border-t border-border pt-2 mt-1">
                            <div class="text-xs font-medium text-primary">Proposition : @_smartResult.DownloadSuggestion.Name</div>
                            <div class="text-xs text-muted">@_smartResult.DownloadSuggestion.Description · @_smartResult.DownloadSuggestion.DownloadSize</div>
                            <button class="mt-2 text-xs bg-accent hover:bg-accent-hover text-primary rounded-lg px-3 py-1.5 border-0 cursor-pointer" @onclick="() => OnDownload(_smartResult.DownloadSuggestion.Name)" disabled="@_downloading">Télécharger @_smartResult.DownloadSuggestion.Name</button>
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_smartStatus))
            {
                <div class="mt-2 text-xs text-muted">@_smartStatus</div>
            }
        </div>
    </div>

    @if (_showIntegrations || _showModels || _showApp)
    {
        @if (_showIntegrations)
        {
            <div class="mb-6 rounded-xl border border-border bg-surface/40">
                <button class="w-full flex items-center justify-between px-4 py-3 text-left bg-transparent border-0 cursor-pointer" @onclick="() => _showIntegrations = false">
                    <span class="text-sm font-medium text-primary">Intégrations</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" class="text-muted rotate-90 transition-transform"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
                <div class="px-4 pb-4 border-t border-border">
                    <div class="text-xs text-muted mt-3 mb-3">Google, Discord, Twilio, Instagram, Hermes, Alexa, Home Assistant. Stockés localement.</div>
                    @if (_integ is null)
                    {
                        <button class="bg-accent hover:bg-accent-hover text-primary rounded-lg px-4 py-2 text-sm font-medium border-0 cursor-pointer" @onclick="LoadIntegrations">Charger les identifiants</button>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <label class="block"><span class="text-xs text-muted">Google — Client ID</span>
                                <input type="password" class="w-full bg-mainbg border border-border rounded-lg px-3 py-2 text-sm text-primary outline-none mt-1" @bind="_integ.Google.ClientId" /></label>
