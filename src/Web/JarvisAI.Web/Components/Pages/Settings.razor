    private async Task LoadVoiceSettingsAsync()
    {
        try { var res = await Http.GetAsync("/api/voice/settings"); if (res.IsSuccessStatusCode) { _settings = JsonSerializer.Deserialize<VoiceSettingsModel>(await res.Content.ReadAsStringAsync()) ?? new(); } } catch { }
    }
    private async Task LoadDevicesAsync()
    {
        try
        {
            var res = await Http.GetAsync("/api/voice/devices");
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                if (doc.RootElement.TryGetProperty("mics", out var mics))
                    foreach (var el in mics.EnumerateArray()) _mics.Add(new DeviceInfo(el.GetProperty("id").GetString() ?? "", el.GetProperty("label").GetString() ?? ""));
                if (doc.RootElement.TryGetProperty("speakers", out var speakers))
                    foreach (var el in speakers.EnumerateArray()) _speakers.Add(new DeviceInfo(el.GetProperty("id").GetString() ?? "", el.GetProperty("label").GetString() ?? ""));
            }
        }
        catch { }
        if (!_mics.Any(m => string.IsNullOrEmpty(m.Id) || m.Label.Contains("defaut", StringComparison.OrdinalIgnoreCase))) _mics.Insert(0, new DeviceInfo("", "Par defaut"));
        if (!_speakers.Any(s => string.IsNullOrEmpty(s.Id) || s.Label.Contains("defaut", StringComparison.OrdinalIgnoreCase))) _speakers.Insert(0, new DeviceInfo("", "Par defaut"));
        StateHasChanged();
    }
    private async Task LoadVoicesAsync()
    {
        try
        {
            var res = await Http.GetAsync("/api/voice/voices");
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                _voiceList.Clear();
                foreach (var el in doc.RootElement.EnumerateArray())
                    _voiceList.Add(new VoiceInfo(el.TryGetProperty("id", out var idProp) ? idProp.GetString() ?? "" : "", el.TryGetProperty("engine", out var engProp) ? engProp.GetString() ?? "" : ""));
                _voices = _voiceList.Select(v => v.Id).ToList();
            }
            await LoadEngineStatusAsync();
            StateHasChanged();
        }
        catch { }
    }
    private async Task LoadEngineStatusAsync()
    {
        try { var res = await Http.GetAsync("/api/voice/engine/status"); if (res.IsSuccessStatusCode) { using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync()); foreach (var el in doc.RootElement.EnumerateArray()) { var engine = el.TryGetProperty("engine", out var engProp) ? engProp.GetString() ?? "" : ""; if (el.TryGetProperty("available", out var availProp)) _engineAvailable[engine] = availProp.GetBoolean(); } } } catch { }
    }
