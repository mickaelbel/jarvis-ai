    private static readonly (string Name, string Value)[] _accentSwatches = new[]
    {
        ("Vert (défaut)", "#10a37f"),
        ("Bleu", "#3b82f6"),
        ("Violet", "#8b5cf6"),
        ("Rose", "#ec4899"),
        ("Orange", "#f97316"),
