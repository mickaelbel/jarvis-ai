        {
            Key = $"custom_{Guid.NewGuid():N}"[..10],
            DisplayName = "Mon fournisseur",
            Description = "Endpoint OpenAI-compatible personnalisé",
            RequiresKey = false,
            Enabled = true,
            Added = true,
            BaseUrl = "http://localhost:11434/v1",
            ChatPath = "/chat/completions",
            DefaultModel = "",
            Models = Array.Empty<string>(),
