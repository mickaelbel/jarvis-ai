    private async Task LoadAccentAsync()
    {
        try { var saved = await JS.InvokeAsync<string>("jarvis.getPref", "accentColor"); if (!string.IsNullOrWhiteSpace(saved)) _accentColor = saved; else await JS.InvokeVoidAsync("jarvis.initAccent"); } catch { }
    }

    private async Task LoadThemeAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string>("jarvis.getPref", "theme");
            if (!string.IsNullOrWhiteSpace(saved) && saved != "sombre")
            {
                _activeTheme = saved;
                await JS.InvokeVoidAsync("eval", $"document.documentElement.classList.add('theme-{saved}')");
            }
        }
        catch { }
    }
