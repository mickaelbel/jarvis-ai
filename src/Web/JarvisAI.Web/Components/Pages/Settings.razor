    private async Task LoadDevicesAsync()
    {
        try
        {
            var res = await Http.GetAsync("/api/voice/devices");
            if (res.IsSuccessStatusCode)
            {
                using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
                if (doc.RootElement.TryGetProperty("mics", out var mics))
                {
                    foreach (var el in mics.EnumerateArray())
                    {
                        var id = el.GetProperty("id").GetString() ?? "";
                        var label = el.GetProperty("label").GetString() ?? id;
                        _mics.Add(new DeviceInfo(id, label));
                    }
                }
                if (doc.RootElement.TryGetProperty("speakers", out var speakers))
                {
                    foreach (var el in speakers.EnumerateArray())
                    {
                        var id = el.GetProperty("id").GetString() ?? "";
                        var label = el.GetProperty("label").GetString() ?? id;
                        _speakers.Add(new DeviceInfo(id, label));
                    }
                }
            }
        }
        catch { }
        _mics.Insert(0, new DeviceInfo("", "Par défaut"));
        _speakers.Insert(0, new DeviceInfo("", "Par défaut"));
        StateHasChanged();
    }

