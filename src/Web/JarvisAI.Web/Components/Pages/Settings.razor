    private async Task OnTestRouting()
    {
        if (string.IsNullOrWhiteSpace(_testText)) return;
        _testing = true; _smartResult = null; _smartStatus = ""; StateHasChanged();
        try { var json = JsonSerializer.Serialize(new { text = _testText, model = (string?)null }); var res = await Http.PostAsync("/api/smart-routing/test", new StringContent(json, Encoding.UTF8, "application/json")); if (res.IsSuccessStatusCode) _smartResult = JsonSerializer.Deserialize<SmartRouteDto>(await res.Content.ReadAsStringAsync()); else _smartStatus = "Erreur"; }
        catch (Exception ex) { _smartStatus = $"Erreur : {ex.Message}"; }
        finally { _testing = false; StateHasChanged(); }
    }
    private async Task OnDownload(string name) { if (_downloading) return; _downloading = true; _smartStatus = $"Telechargement de {name}..."; StateHasChanged(); try { await Downloads.StartPullAsync(name); _smartStatus = $"Telechargement termine."; } catch (Exception ex) { _smartStatus = $"Erreur : {ex.Message}"; } finally { _downloading = false; StateHasChanged(); } }

    private async Task LoadProvidersAsync()
    {
        try { var res = await Http.GetAsync("/api/ai-providers"); if (res.IsSuccessStatusCode) { var items = JsonSerializer.Deserialize<List<ProviderViewModel>>(await res.Content.ReadAsStringAsync()); if (items is not null) { _providers = items.Where(p => p.Added).ToList(); _availableToAdd = items.Where(p => !p.Added).ToList(); StateHasChanged(); } } } catch { }
    }
    private void AddCustomProvider() { var c = new ProviderViewModel { Key = $"custom_{Guid.NewGuid():N}"[..10], DisplayName = "Mon fournisseur", Description = "Endpoint OpenAI-compatible", RequiresKey = false, Enabled = true, Added = true, BaseUrl = "http://localhost:11434/v1", ChatPath = "/chat/completions" }; _providers.Add(c); _expandedProviderKey = c.Key; _showAddPanel = false; StateHasChanged(); }
    private void ToggleProvider(ProviderViewModel p) { _expandedProviderKey = _expandedProviderKey == p.Key ? null : p.Key; StateHasChanged(); }
    private void ToggleAddPanel() { _showAddPanel = !_showAddPanel; StateHasChanged(); }
    private void RemoveProvider(ProviderViewModel p) { _providers.RemoveAll(x => x.Key == p.Key); _availableToAdd.Add(p); StateHasChanged(); }
    private async Task SaveProviders() { _providersSaving = true; StateHasChanged(); try { var json = JsonSerializer.Serialize(new { providers = _providers }); var res = await Http.PostAsync("/api/ai-providers", new StringContent(json, Encoding.UTF8, "application/json")); _providersStatus = res.IsSuccessStatusCode ? "Enregistre" : "Erreur"; if (res.IsSuccessStatusCode) await LoadAvailableModelsAsync(); } catch (Exception ex) { _providersStatus = $"Erreur : {ex.Message}"; } finally { _providersSaving = false; StateHasChanged(); } }
    private async Task TestProvider(ProviderViewModel p) { _providerTestingKey = p.Key; StateHasChanged(); try { var json = JsonSerializer.Serialize(new { text = "Test", model = string.IsNullOrWhiteSpace(p.DefaultModel) ? null : p.DefaultModel }); var res = await Http.PostAsync("/api/smart-routing/test", new StringContent(json, Encoding.UTF8, "application/json")); if (res.IsSuccessStatusCode) _providerResults[p.Key] = JsonSerializer.Deserialize<SmartRouteDto>(await res.Content.ReadAsStringAsync()); } catch { } finally { _providerTestingKey = ""; StateHasChanged(); } }
    private async Task TestVoiceModel() { if (_voiceTesting) return; _voiceTesting = true; _voiceTestResult = null; StateHasChanged(); try { var json = JsonSerializer.Serialize(new { text = "Test", model = string.IsNullOrWhiteSpace(_settings.Model) ? null : _settings.Model }); var res = await Http.PostAsync("/api/smart-routing/test", new StringContent(json, Encoding.UTF8, "application/json")); if (res.IsSuccessStatusCode) _voiceTestResult = JsonSerializer.Deserialize<SmartRouteDto>(await res.Content.ReadAsStringAsync()); } catch (Exception ex) { _voiceTestResult = new SmartRouteDto("", "", ex.Message, false, false, ex.Message, "", 0, null); } finally { _voiceTesting = false; StateHasChanged(); } }
    private async Task LoadAvailableModelsAsync() { try { var res = await Http.GetAsync("/api/models/available"); if (res.IsSuccessStatusCode) { _availableModels = JsonSerializer.Deserialize<List<AvailableModel>>(await res.Content.ReadAsStringAsync()) ?? new(); StateHasChanged(); } } catch { } }
    private async Task LoadModelsPathAsync() { try { var res = await Http.GetAsync("/api/ollama/models-path"); if (res.IsSuccessStatusCode) { using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync()); _modelsPath = doc.RootElement.TryGetProperty("path", out var p) ? p.GetString() ?? "" : ""; _modelsPathInfo = doc.RootElement.TryGetProperty("exists", out var e) && e.GetBoolean() ? $"Actif : {_modelsPath}" : $"Actif : {_modelsPath} (sera cree)"; } } catch { } }
    private async Task SaveModelsPath() { _savingModelsPath = true; try { var json = JsonSerializer.Serialize(new { path = _modelsPath }); var res = await Http.PostAsync("/api/ollama/models-path", new StringContent(json, Encoding.UTF8, "application/json")); var text = await res.Content.ReadAsStringAsync(); if (res.IsSuccessStatusCode) { using var doc = JsonDocument.Parse(text); _modelsPath = doc.RootElement.TryGetProperty("path", out var p) ? p.GetString() ?? _modelsPath : _modelsPath; _modelsPathInfo = "Enregistre."; } else _modelsPathInfo = $"Erreur : {text}"; } catch (Exception ex) { _modelsPathInfo = $"Erreur : {ex.Message}"; } finally { _savingModelsPath = false; } }
    private async Task LoadSecurityOptionsAsync() { try { await Http.GetAsync("/api/security/options"); } catch { } }

    private async Task LoadIntegrations() { try { var res = await Http.GetAsync("/api/integrations"); if (res.IsSuccessStatusCode) { _integ = JsonSerializer.Deserialize<JarvisAI.Infrastructure.Integrations.IntegrationsSettings>(await res.Content.ReadAsStringAsync(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new(); } } catch { _integ = new(); } }
    private async Task SaveIntegrations() { if (_integ is null) return; _savingIntegrations = true; try { var json = JsonSerializer.Serialize(_integ, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }); var res = await Http.PostAsync("/api/integrations", new StringContent(json, Encoding.UTF8, "application/json")); _integrationsInfo = res.IsSuccessStatusCode ? "Enregistre" : "Erreur"; } catch (Exception ex) { _integrationsInfo = $"Erreur : {ex.Message}"; } finally { _savingIntegrations = false; StateHasChanged(); } }
    private async Task TestIntegration(string key) { _testingIntegration = key; _integrationTestInfo = "Test..."; StateHasChanged(); try { var res = await Http.PostAsync($"/api/integrations/test/{key}", null); var json = await res.Content.ReadAsStringAsync(); using var doc = JsonDocument.Parse(json); var ok = doc.RootElement.GetProperty("success").GetBoolean(); _integrationTestOk = ok; _testedIntegration = key; _integrationTestInfo = ok ? "OK" : "Echec"; } catch { _integrationTestOk = false; _integrationTestInfo = "Erreur"; } finally { _testingIntegration = null; StateHasChanged(); } }

    private void LoadProfiles() { _profiles = Profiles.ListProfiles().ToList(); _selectedProfile = Profiles.ActiveProfile; }
    private Task LoadProfile() { var json = Profiles.LoadProfile(_selectedProfile); if (json is null) { _profileStatus = "Profil introuvable."; return Task.CompletedTask; } Profiles.SetActive(_selectedProfile); _profileStatus = $"Profil '{_selectedProfile}' charge."; StateHasChanged(); return Task.CompletedTask; }
    private async Task SaveAsProfile() { var name = await JS.InvokeAsync<string>("prompt", "Nom du nouveau profil :", ""); if (string.IsNullOrWhiteSpace(name)) return; var json = JsonSerializer.Serialize(_settings, new JsonSerializerOptions { WriteIndented = true }); Profiles.SaveProfile(name, json); Profiles.SetActive(name); LoadProfiles(); _selectedProfile = name; _profileStatus = $"Profil '{name}' sauvegarde."; }
    private Task DeleteProfile() { if (_selectedProfile == "default") return Task.CompletedTask; Profiles.DeleteProfile(_selectedProfile); LoadProfiles(); _selectedProfile = "default"; _profileStatus = "Profil supprime."; return Task.CompletedTask; }
    private async Task ExportConfig() { var json = JsonSerializer.Serialize(_settings, new JsonSerializerOptions { WriteIndented = true }); var bytes = Encoding.UTF8.GetBytes(json); var base64 = Convert.ToBase64String(bytes); await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:application/json;base64,{base64}';a.download='jarvis-settings.json';a.click();"); }
    private async Task ImportConfig() { var json = await JS.InvokeAsync<string>("prompt", "Collez le JSON :", ""); if (string.IsNullOrWhiteSpace(json)) return; try { var imported = JsonSerializer.Deserialize<VoiceSettingsModel>(json); if (imported is not null) { _settings = imported; _profileStatus = "Importe. Cliquez Enregistrer."; } } catch { _profileStatus = "JSON invalide."; } }

    private static float ParseFloat(string s) => float.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0f;
    private static float ParseSliderFloat(string? s, float fallback) => float.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : fallback;
    private static int ParseSliderInt(string? s, int fallback) => int.TryParse(s, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : fallback;

    private static string GetVoiceDisplayName(string voiceId) => voiceId switch
    {
        "fr-FR-HenriNeural" => "Henri (Masculin - JARVIS-like)",
        "fr-FR-DeniseNeural" => "Denise (Feminin)",
        "fr-FR-EloiseNeural" => "Eloise (Feminin jeune)",
        "fr-FR-JacquesNeural" => "Jacques (Masculin grave)",
        "fr-FR-YvetteNeural" => "Yvette (Feminin mature)",
        "fr_FR-upmc-medium" => "Piper Henri (Local, moyen)",
        "fr_FR-siwis-low" => "Piper Siwis (Local, douce)",
        "fr_FR-tom-medium" => "Piper Tom (Local, moyen)",
        _ => voiceId.Replace("fr_FR-", "Piper ").Replace("fr-FR-", "").Replace("Neural", "").Replace("-", " ").Trim()
    };
    private static readonly string[] EngineOrder = { "edge", "piper", "xtts", "windows" };
    private List<VoiceGroup> GetVoiceGroups() { var groups = new List<VoiceGroup>(); foreach (var engine in EngineOrder) { var voices = _voiceList.Where(v => v.Engine == engine).ToList(); if (voices.Count > 0) groups.Add(new VoiceGroup(engine, GetEngineDisplayName(engine), voices)); } return groups; }
    private static string GetEngineDisplayName(string engine) => engine switch { "edge" => "Edge TTS", "piper" => "Piper (local)", "xtts" => "XTTS (local)", "windows" => "Windows (SAPI)", _ => engine };
    private sealed record VoiceGroup(string Engine, string Label, List<VoiceInfo> Voices);
}
