@inherits LayoutComponentBase
@using System.Text.Json
@using JarvisAI.Web.Services
@inject NavigationManager Navigation
@inject AdvancedSettingsService Settings

<div class="app-shell">
    <div class="app-main">
        <header class="app-topbar">
            <div class="flex items-center gap-3">
                <div class="flex flex-col">
                    <span class="text-sm font-bold tracking-widest text-primary" style="letter-spacing:0.15em">JARVIS</span>
                    <span class="text-[8px] tracking-[0.2em] text-muted uppercase">Local AI Core</span>
                </div>
            </div>
            <div class="flex items-center gap-2 ml-auto">
                <button class="mode-toggle-btn @(_isShowMode ? "mode-show" : "mode-speed")" @onclick="ToggleMode" title="@(_isShowMode ? "Mode Show — actions humaines" : "Mode Speed — outils directs")">
                    <span class="mode-toggle-track">
                        <span class="mode-toggle-thumb"></span>
                    </span>
                    <span class="mode-toggle-label">@(_isShowMode ? "SHOW" : "SPEED")</span>
                </button>
                <button class="topbar-icon-btn" @onclick="GoSettings" title="Parametres">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </button>
            </div>
        </header>
        <TabBar @ref="_tabBar" />
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<ConfirmDialog />
<ToastNotification />

@code {
    private static readonly HttpClient Http = new() { Timeout = TimeSpan.FromSeconds(5) };
    private TabBar? _tabBar;
    private bool _isShowMode => Settings.Get().Mode == ExecutionMode.Show;

    public static event Action<string, string>? SessionSyncRequested;
    public static event Action<bool>? StreamStateChanged;
    public static event Action<ExecutionMode>? ExecutionModeChanged;

    public static void SyncSession(string sessionId, string title) => SessionSyncRequested?.Invoke(sessionId, title);
    public static void SetStreaming(bool isStreaming) => StreamStateChanged?.Invoke(isStreaming);

    private void ToggleMode()
    {
        Settings.Update(s => s.Mode = s.Mode == ExecutionMode.Show ? ExecutionMode.Speed : ExecutionMode.Show);
        ExecutionModeChanged?.Invoke(Settings.Get().Mode);
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        SessionSyncRequested += OnSessionSync;
        StreamStateChanged += OnStreamChanged;
    }

    private void OnSessionSync(string sessionId, string title)
    {
        _tabBar?.SyncSession(sessionId, title);
    }

    private void OnStreamChanged(bool isStreaming)
    {
        _tabBar?.SetStreaming(isStreaming);
    }

    private void NewChat()
    {
        Pages.Chat.RequestNewChat();
        Navigation.NavigateTo("/chat?new=1");
    }

    private void GoSettings() => Navigation.NavigateTo("/settings");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var res = await Http.GetAsync(Navigation.BaseUri + "api/setup/status");
            if (!res.IsSuccessStatusCode) return;
            using var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("firstRun", out var fr) && fr.GetBoolean())
                Navigation.NavigateTo("/setup", replace: true);
        }
        catch { }
    }
}
