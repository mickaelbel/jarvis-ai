@using JarvisAI.Web.Services
@inject ToastService Toast
@implements IDisposable
@rendermode InteractiveServer

<div class="fixed top-4 right-4 z-[100] flex flex-col gap-2 w-[340px] max-w-[calc(100vw-2rem)]">
    @foreach (var toast in Toast.Toasts)
    {
        <div class="jarvis-toast jarvis-toast-@toast.Type" role="alert">
            <div class="jarvis-toast-icon">
                @if (toast.Type == "success")
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg>
                }
                else if (toast.Type == "error")
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                }
            </div>
            <div class="min-w-0 flex-1">
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <div class="text-xs font-semibold text-primary">@toast.Title</div>
                }
                <div class="text-xs text-secondary break-words">@toast.Message</div>
            </div>
            <button class="jarvis-toast-close" @onclick="() => Toast.Remove(toast.Id)" aria-label="Dismiss">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
    }
</div>

@code {
    private Timer? _expiryTimer;

    protected override void OnInitialized()
    {
        Toast.Changed += OnToastsChanged;
        _expiryTimer = new Timer(PruneExpired, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    private void PruneExpired(object? state) => InvokeAsync(() => Toast.ClearExpired(DateTimeOffset.UtcNow));

    public void Dispose()
    {
        Toast.Changed -= OnToastsChanged;
        _expiryTimer?.Dispose();
    }
}
