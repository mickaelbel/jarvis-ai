@if (HasData)
{
    <div class="flex flex-wrap items-center gap-1.5 mt-2 opacity-90">
        @if (!string.IsNullOrEmpty(Model))
        {
            <span class="jarvis-chip" title="Model used">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                @Model
            </span>
        }
        @if (DurationMs.HasValue)
        {
            <span class="jarvis-chip" title="Generation time">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                @FormatDuration(DurationMs.Value)
            </span>
        }
        @if (TokenCount.HasValue)
        {
            <span class="jarvis-chip" title="Tokens">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                @TokenCount.Value tokens
            </span>
        }
        @if (ToolCallCount > 0)
        {
            <span class="jarvis-chip" title="Tool calls executed">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                @ToolCallCount tool call@(ToolCallCount != 1 ? "s" : "")
            </span>
        }
        @if (AgentDurationMs.HasValue)
        {
            <span class="jarvis-chip" title="Total agent duration">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="10" height="10"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                Agent @FormatDuration(AgentDurationMs.Value)
            </span>
        }
    </div>
}

@code {
    [Parameter] public string? Model { get; set; }
    [Parameter] public double? DurationMs { get; set; }
    [Parameter] public int? TokenCount { get; set; }
    [Parameter] public int ToolCallCount { get; set; }
    [Parameter] public double? AgentDurationMs { get; set; }

    private bool HasData =>
        !string.IsNullOrEmpty(Model) ||
        DurationMs.HasValue ||
        TokenCount.HasValue ||
        ToolCallCount > 0 ||
        AgentDurationMs.HasValue;

    private static string FormatDuration(double ms)
    {
        if (ms < 1000) return $"{ms:F0} ms";
        var seconds = ms / 1000;
        if (seconds < 60) return $"{seconds:F1} s";
        return $"{TimeSpan.FromSeconds(seconds):mm\\:ss}";
    }
}
