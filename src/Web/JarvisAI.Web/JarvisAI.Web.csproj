<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\JarvisAI.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\JarvisAI.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Domain\JarvisAI.Domain.csproj" />
    <ProjectReference Include="..\..\Core\JarvisAI.Core.csproj" />
    <ProjectReference Include="..\..\..\Plugins\SystemControl\JarvisAI.Plugins.SystemControl.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JarvisAI.Tests" />
  </ItemGroup>

  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="..\..\..\Plugins\SystemControl\bin\$(Configuration)\net8.0\JarvisAI.Plugins.SystemControl.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)Plugins\SystemControl" />
    <MakeDir Directories="$(OutDir)Plugins\SystemControl" />
    <Copy SourceFiles="@(PluginFiles)"
          DestinationFiles="@(PluginFiles->'$(OutDir)Plugins\SystemControl\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
